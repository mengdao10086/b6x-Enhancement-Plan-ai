<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只放 LSPosed 模块元数据；application/label/icon 与 Activity 留在各自 app -->
    <application>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="53" />
        <meta-data
            android:name="xposeddescription"
            android:value="修复B6X/B7X超频软件在安卓16的蓝牙问题，并内置智能温控：原生界面调参、一键部署守护进程" />

        <!-- LSPosed 推荐作用域：管理器 > 模块 > 推荐勾选的应用 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
