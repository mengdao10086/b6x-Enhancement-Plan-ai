<?xml version="1.0" encoding="utf-8"?>
<!--
    应用外壳：标题栏（标题 + 右侧设置按钮）+ 页面容器 + 底部页签栏（状态 / 配置 · 曲线 / 日志）。

    - 页签在底部：本文件只是菜单的承载处，顺序由 res/menu/menu_bottom.xml 决定，
      而那份顺序必须与 SetupActivity.MENU_IDS 严格一致（错位会静默显示错页）。
    - 页面容器是 ViewPager2：翻页由它接管（跟手滑动），故外壳不再有手势代码与手写转场。
    - 标题栏几何：标题到窗口顶端的距离 = title_pad_top(7dp)（原为 ?attr/actionBarSize 里垂直居中的约 14dp 的一半）；
      标题到标题栏下边界 = 到窗口左侧 = space_l(16dp)。因此标题栏高度不再取 ?attr/actionBarSize，
      行高由标题文本行高决定；右侧设置按钮受同一行高约束，故取 title_action_size(28dp)。
    - 子 agent 不要改本文件。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== 标题栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/title_pad_top"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/space_l">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_setup"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <!-- 设置按钮：原「[4] 界面」那组界面参数搬到了独立设置页，入口在这里 -->
        <ImageButton
            android:id="@+id/action_settings"
            android:layout_width="@dimen/title_action_size"
            android:layout_height="@dimen/title_action_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- ===== 页面容器：ViewPager2（跟手滑动 + fling 吸附；三页由 FragmentStateAdapter 持有） ===== -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/page_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="?attr/colorOutlineVariant" />

    <!-- ===== 底部页签栏 ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom" />
</LinearLayout>
