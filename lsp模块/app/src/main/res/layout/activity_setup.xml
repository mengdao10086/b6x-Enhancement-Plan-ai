<?xml version="1.0" encoding="utf-8"?>
<!--
    应用外壳：标题栏（标题 + 右侧设置按钮）+ 页面容器 + 底部页签栏（状态 / 配置 · 曲线 / 日志）。

    - 系统栏让位不用 fitsSystemWindows：改由 SetupActivity 调 ui/EdgeToEdge（下侧沉浸式，
      底栏背景铺到屏幕底、条目留在系统手势条之上），故本文件不写 fitsSystemWindows。
    - 页签在底部：本文件只是菜单的承载处，顺序由 res/menu/menu_bottom.xml 决定，
      而那份顺序必须与 SetupActivity.MENU_IDS 严格一致（错位会静默显示错页）。
    - 页面容器是 ViewPager2：翻页由它接管（跟手滑动），故外壳不再有手势代码与手写转场。
    - 标题栏几何：标题到窗口顶端的距离 = title_pad_top(4dp)（原为 ?attr/actionBarSize 里垂直居中的约 14dp 的一半取整）；
      标题到标题栏下边界 = title_pad_bottom(8dp)，到窗口左侧则仍为 space_l(16dp)（两者不再共用同一值）。
      因此标题栏高度不再取 ?attr/actionBarSize，行高由标题文本行高决定；
      右侧设置按钮受同一行高约束，故取 title_action_size(28dp)。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- ===== 标题栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/title_pad_top"
        android:paddingEnd="@dimen/space_l"
        android:paddingBottom="@dimen/title_pad_bottom">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_setup"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <!-- 设置按钮：原「[4] 界面」那组界面参数搬到了独立设置页，入口在这里 -->
        <ImageButton
            android:id="@+id/action_settings"
            android:layout_width="@dimen/title_action_size"
            android:layout_height="@dimen/title_action_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- ===== 页面容器：ViewPager2（跟手滑动 + fling 吸附；三页由 FragmentStateAdapter 持有） ===== -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/page_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/divider_height"
        android:background="?attr/colorOutlineVariant" />

    <!--
        ===== 底部页签栏 =====
        高度 53dp 取 M3 默认 80dp 的 2/3（80dp 是为活动指示器留的余量，本栏只用图标 + 文字）；
        条目上内边距 @dimen/bottom_nav_pad_top 保持 M3 默认的 2/3 = 8dp 不动；
        条目下内边距 @dimen/bottom_nav_pad_bottom 再收到 3dp，用于把标签文字下移、
        消除它与图标之间原有的 6dp 重合（推算见 dimens.xml 该 dimen 的注释）。
        图标 24dp 与标签 12sp 不动；若真机上标签仍贴到条底，再动 @dimen/bottom_nav_height。
        下面两个 itemPadding 作用在菜单视图上，不是本控件自身的 paddingBottom；后者由 ui/EdgeToEdge
        独占改写（= 系统条高），故两者互不叠加。
        本处声明的 53dp 是 EdgeToEdge 的"基准内容高"：运行时 height 会变成 53dp + 系统条高，
        背景铺到屏幕底、页签留在系统条之上；键盘弹起时回到 53dp。
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="?attr/colorSurface"
        app:itemPaddingTop="@dimen/bottom_nav_pad_top"
        app:itemPaddingBottom="@dimen/bottom_nav_pad_bottom"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom" />
</LinearLayout>
