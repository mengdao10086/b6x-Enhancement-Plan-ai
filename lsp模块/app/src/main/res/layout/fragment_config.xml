<?xml version="1.0" encoding="utf-8"?>
<!--
    配置 + 曲线合并页（页签「配置 · 曲线」）。自上而下三段，对齐旧 WebUI 的形态：
      ① 曲线区（区标题 + config_chart_container，ChartFragment 作为子 Fragment 挂进去）
      ② 参数区（区标题 + config_group_container + 错误态/键渲染自检）
      ③ 诊断区（数据文件信息常显在头部 + 可折叠的配置诊断正文）
    分组卡片由 ConfigGroupBinder 动态加入 config_group_container，每个键的行由 ConfigKeyRow
    动态生成（数据源是 ConfigStore，背后即 assets/params.json）。
    本文件不承载任何键定义，改动键表不需要动布局；曲线区自身的内容在 fragment_chart.xml。
    区标题的行高一律与分组卡头一致（@dimen/row_min_height + @dimen/card_padding）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <!-- ===== ① 曲线区区标题（行高同分组卡头） ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_min_height"
            android:padding="@dimen/card_padding"
            android:text="@string/chart_section_curve"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

        <!-- ===== ① 曲线区容器：ChartFragment 由 ConfigFormFragment 挂进来 ===== -->
        <FrameLayout
            android:id="@+id/config_chart_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- ===== ② 参数区区标题（行高同分组卡头，48dp 那一套） ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:gravity="center_vertical"
            android:minHeight="@dimen/row_min_height"
            android:padding="@dimen/card_padding"
            android:text="@string/config_section_title"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

        <!-- ===== ② 错误态：参数定义没加载成功时，明确报错，不给空列表 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/config_error_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_error_title"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle"
                    android:textColor="@color/state_error" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/config_error_body"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

                <TextView
                    android:id="@+id/config_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== ② 键渲染自检 / 未定义键 / 读取提示 ===== -->
        <TextView
            android:id="@+id/config_self_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
            android:visibility="gone" />

        <!-- ===== ② 分组容器 ===== -->
        <LinearLayout
            android:id="@+id/config_group_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ===== ③ 诊断区（可展开） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/config_diag_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/config_diag_title"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

                    <TextView
                        android:id="@+id/config_diag_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/config_arrow_collapsed"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
                        android:textSize="@dimen/text_arrow" />
                </LinearLayout>

                <!-- 数据文件信息（原曲线页信息条）：常显，折叠只作用于下方的配置诊断正文。
                     内容由 ChartFragment 经 ChartFragment.Host 回调提供，曲线卡内不再重复。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/chart_section_file"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

                    <TextView
                        android:id="@+id/config_diag_datafile_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/chart_loading"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/config_diag_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/card_padding"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/config_diag_mtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

                    <TextView
                        android:id="@+id/config_diag_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                        android:textIsSelectable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/config_diag_refresh"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/config_diag_action_refresh" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
