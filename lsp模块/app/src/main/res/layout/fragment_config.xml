<?xml version="1.0" encoding="utf-8"?>
<!--
    配置页骨架。分组卡片由 ConfigGroupBinder 动态加入 config_group_container，
    每个键的行由 ConfigKeyRow 动态生成（数据源是 ConfigStore，背后即 assets/params.json）。
    本文件不承载任何键定义，改动键表不需要动布局。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/config_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <!-- ===== 错误态：参数定义没加载成功时，明确报错，不给空列表 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/config_error_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_error_title"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle"
                    android:textColor="@color/state_error" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:text="@string/config_error_body"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

                <TextView
                    android:id="@+id/config_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 键渲染自检 / 未定义键 / 读取提示 ===== -->
        <TextView
            android:id="@+id/config_self_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
            android:visibility="gone" />

        <!-- ===== 分组容器 ===== -->
        <LinearLayout
            android:id="@+id/config_group_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ===== 诊断区（可展开） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/config_diag_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/config_diag_title"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

                    <TextView
                        android:id="@+id/config_diag_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/config_arrow_collapsed"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/config_diag_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/card_padding"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/config_diag_mtime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

                    <TextView
                        android:id="@+id/config_diag_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                        android:textIsSelectable="true" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/config_diag_refresh"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/config_diag_action_refresh" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
