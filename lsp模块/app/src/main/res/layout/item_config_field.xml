<?xml version="1.0" encoding="utf-8"?>
<!--
    一个输入字段（int 键一个，multi 键每个字段一个）。两种形态按定义里的 fields[].bool 二选一：
      布尔字段 → config_field_switch_row（字段名 leading + 开关 trailing，与其它输入框同高感）
      数值字段 → config_field_layout（label 作 hint、单位与范围作下方灰字）
    下方灰字整行折行：多值键里它跟着自己的输入框，长单位（如"制冷强度档位（0~194 硬件原始档位值）"）
    不会被后缀挤压输入框；单值键的这份说明由 ConfigKeyRow 移到行级、按整行宽折行。

    宽度不写死：ConfigKeyRow 用输入框自己的画笔量出像素宽再回写 layout_width
    （见 ConfigKeyRow#measuredFieldWidth），宽只认说明与内容，装不下由外层容器换行；
    这里给 wrap_content 只是"未被回写时"的兜底。path 键的字段由 ConfigKeyRow 回写成吃满行尾。
    高度写死 @dimen/field_height：Material OutlinedBox 默认高约 56dp，不给死压不下来。

    内层 EditText（宽度跟随框）：
      · 说明（浮起提示）贴圆角、值仍居中：浮起说明的位置由 material 两处决定——
        可用框 = [框左 + editText.getPaddingLeft(), 框右 − editText.getPaddingRight()]
        （TextInputLayout.calculateCollapsedTextBounds 的 OUTLINED 分支），框内对齐取其水平分量
        （setEditText / onLayout 里 setCollapsedTextGravity((gravity & ~VERTICAL) | CENTER_VERTICAL)，
        水平分量原样带入）。所以取 gravity="start|center_vertical"：说明起笔落在框左 8dp =
        圆角半径 @dimen/field_radius 刚结束处，不再像 gravity="center" 那样被居中、两头都留白
        （框越宽留白越多）。「值」的水平居中改由 android:textAlignment="center" 承担
        （只决定文本行对齐，不进 getGravity()），两者互不牵动。
        说明可用宽 = 框宽 − 左右内边距，装不下时 material 打省略号——故 ConfigKeyRow 按
        「说明文字宽 / 内容文字宽取大者」量出框宽，说明那一侧另加 @dimen/config_hint_slack(1dp)
        的防截断安全量。
        说明的字号与正文不是同一档：material 画说明用的是 hintTextAppearance
        （M3 的 OutlinedBox 样式 = ?attr/textAppearanceBodySmall，12sp + letterSpacing 0.0333），
        正文才是 @dimen/config_field_text_size(16sp)。ConfigKeyRow 量说明取的就是这份 12sp 口径
        （见 ConfigKeyRow#hintPaint）——量宽与渲染同档，框才不会比说明宽出约 1/3。
        属性里的 app:expandedHintEnabled="false" 是这"同档"的另一半：不关的话，"空且未聚焦"时
        说明会在框内按正文 16sp 展开，同一份说明就有两种字号。本项目字段建行即回填，
        说明恒处于浮起的 12sp 档，关掉只是去掉那一瞬的另一种渲染。
      · 左右内边距压到 @dimen/field_radius(8dp)：M3 默认 16dp，收掉的那 8dp 全给可用内容宽，
        圆角 8dp 之外不再留空白。它同时就是上面那个说明可用框的内缩量（8dp = 圆角半径），
        所以这 8dp 再压就会让说明压到圆角上，不能动。
      · 上下内边距不对称（上 @dimen/config_field_pad_top 5dp / 下 @dimen/config_field_pad_bottom 2dp）：
        EditText 高度 match_parent + 垂直居中 → 正文是在"去掉内边距后的内容区"（36 − 5 − 2 = 29dp）
        里居中的，内边距只决定内容区的高与它的中心。正文行盒（16sp 约 18.75dp）中心 = (5 + 34) / 2 = 19.5dp：
        比框的几何中心（18dp）低 1.5dp = (5 − 2) / 2。算式、留白与"余量最薄处"见 @dimen/config_field_pad_top。
      · scrollHorizontally：等于 setHorizontallyScrolling(true)——单行横向滚动的开关。不开时
        Layout 宽 == 视图宽，scrollX 恒为 0，path 键放不下的右半段（文件名）永远看不见。
        不用已废弃的 singleLine：它顺带改掉 maxLines 之外的行为，这里只需要横向可滚。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 字段名 + 开关也走换行容器：字段名 leading、开关 trailing（贴字段右界）。
         高度取 minHeight @dimen/field_height：与同一键里的输入框等高；
         换行后由内容撑高（定高会把第二行裁掉，WrapRowLayout 已把 minHeight 并进测量）。
         开关自己也必须定高（同 item_config_row.xml 的那段说明）：库样式里的 minHeight 是触控尺寸 48dp，
         光靠容器 minHeight 挡不住，开关会把本行撑到 48dp -->
    <com.example.waspwingtempctrl.ui.WrapRowLayout
        android:id="@+id/config_field_switch_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/field_height"
        android:visibility="gone">

        <TextView
            android:id="@+id/config_field_switch_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/app_on_surface"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/config_field_switch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/field_height"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/switch_trim_end"
            android:gravity="center_vertical"
            android:scaleX="0.75"
            android:scaleY="0.75"
            app:wrapTrailing="true" />
    </com.example.waspwingtempctrl.ui.WrapRowLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/config_field_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/field_height"
        app:expandedHintEnabled="false"
        app:boxCornerRadiusBottomEnd="@dimen/field_radius"
        app:boxCornerRadiusBottomStart="@dimen/field_radius"
        app:boxCornerRadiusTopEnd="@dimen/field_radius"
        app:boxCornerRadiusTopStart="@dimen/field_radius">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/config_field_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="start|center_vertical"
            android:imeOptions="actionDone"
            android:includeFontPadding="false"
            android:inputType="number"
            android:maxLines="1"
            android:minHeight="0dp"
            android:textAlignment="center"
            android:paddingStart="@dimen/field_radius"
            android:paddingTop="@dimen/config_field_pad_top"
            android:paddingEnd="@dimen/field_radius"
            android:paddingBottom="@dimen/config_field_pad_bottom"
            android:scrollHorizontally="true"
            android:textSize="@dimen/config_field_text_size" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 字段说明（单位 / 范围）。多值键里跟着自己的输入框，才看得出属于哪个字段；宽度取字段宽。
         单值键（int / path / 单字段 multi）由 ConfigKeyRow 把它挂到行级、按整行宽折行——
         框宽只由该字段的说明与内容决定（短说明的框很窄），长说明留在框里要折四五行的独立一列。
         左内边距不再动：8dp 是"内容可用宽扩到圆角刚结束"的既有口径（见上面 EditText 那条）。 -->
    <TextView
        android:id="@+id/config_field_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
        android:visibility="gone" />
</LinearLayout>
