<?xml version="1.0" encoding="utf-8"?>
<!--
    分段倍率表的一条「高亮横线」：可见细线 @dimen/ki_cut_insert_line_thickness(4dp)、全宽。
    上下各 @dimen/ki_cut_insert_line_gap(2dp) 是**透明留白**，把可点区外扩到 8dp（视觉上只有那 4dp 线）。
    纵向定位（首/中/末三条各自的外边距，使线落在两行之间正中、且不贴框）由
    KiCutTableEditor#applyLineMargins 在全部横线到位后统一算：线槽净占恒 6dp（＝框的压缩量），
    故模式态「框 30dp + 线 6dp ＝ 常态行高 36dp」，逐行与常态等高、整表总高不变。
    由 KiCutTableEditor 现场 inflate 后 addView 进 ki_cut_cluster_points，夹在各点行之间与首尾。
    <b>默认隐藏</b>（visibility=gone）：只有进入「插入态」（点「添加点」）或「拆分态」（点「拆分簇」）才显示；
    插入态点线＝该处插一行全空行，拆分态改色为拆分线＝在此拆分。
    触摸区只有这一层可点（内层细线不设监听，触摸自然落到外层），且它与点行是兄弟视图，故不会误触输入框正文区。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ki_cut_line_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="@dimen/ki_cut_insert_line_gap"
    android:paddingBottom="@dimen/ki_cut_insert_line_gap"
    android:visibility="gone">

    <View
        android:id="@+id/ki_cut_line_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ki_cut_insert_line_thickness"
        android:background="@color/ki_cut_insert_line" />
</LinearLayout>
