<?xml version="1.0" encoding="utf-8"?>
<!--
    日志页（D3）。四段式：顶部信息条（路径 / 修改时间）→ 关键词过滤 → 日志列表（占满剩余高度）
    → 底部统计行（已读取行数 / 渲染上限，文件大小 / 尾读上限）。日志窗口压在页面最下方。
    读取失败时不进列表，直接把 AppFiles.diagnose() 的原文铺在列表位置，绝不静默留白。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="@dimen/page_padding">

    <!-- ===== 顶部信息条：路径 / 修改时间 ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/log_section_file"
                android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

            <TextView
                android:id="@+id/log_info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/log_loading"
                android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                android:textIsSelectable="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== 关键词过滤 ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/log_section_filter"
                android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

            <!-- 高度显式给死（@dimen/log_filter_height）才能压过 OutlinedBox 的默认高 -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/log_filter_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="@dimen/log_filter_height"
                android:hint="@string/log_filter_hint"
                app:endIconMode="clear_text"
                app:boxCornerRadiusBottomEnd="@dimen/field_radius"
                app:boxCornerRadiusBottomStart="@dimen/field_radius"
                app:boxCornerRadiusTopEnd="@dimen/field_radius"
                app:boxCornerRadiusTopStart="@dimen/field_radius">

                <!--
                    字号直接写在控件上、不走 textAppearance：两处都写 textSize 时谁生效取决于控件实现，
                    这里只留一个来源。minHeight 与垂直内边距收小，16sp 文字才放得进压缩后的框。
                -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/log_filter_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="0dp"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingBottom="@dimen/space_xs"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/log_filter_text_size" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 命中计数：由 LogFragment 在有关键词时显示，其余情况置 GONE（行数信息在底部统计行） -->
            <TextView
                android:id="@+id/log_count_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== 日志区：列表 / 读取失败诊断 / 空态 / 回到底部 ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!--
                滚动条：跟随刷新每 2 秒滚动一次会把滚动条反复唤醒 → 亮灭闪烁。
                延迟给到 2000ms（≈刷新周期）后它不再闪灭，但仍在无操作后自行淡出
                （fadeScrollbars 保持默认 true，不做成"永不消失"）。
            -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/log_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/space_s"
                android:scrollbarDefaultDelayBeforeFade="2000"
                android:scrollbarFadeDuration="400"
                android:scrollbars="vertical" />

            <!-- 读取失败：原样展示 AppFiles.diagnose() 的多行诊断 -->
            <ScrollView
                android:id="@+id/log_failure_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/card_padding"
                android:visibility="gone">

                <TextView
                    android:id="@+id/log_failure_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                    android:textIsSelectable="true" />
            </ScrollView>

            <TextView
                android:id="@+id/log_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="@dimen/space_l"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
                android:visibility="gone" />

            <!--
                纯图标按钮（无 android:text）：用 Material3 的图标按钮样式，它自带圆形轮廓与 48dp 触控尺寸；
                再加 minWidth/minHeight、iconPadding 归零与 iconGravity，避免被文字内边距撑成长条。
                contentDescription 保留「回到底部」语义，供读屏使用。
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/log_follow_btn"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/space_s"
                android:contentDescription="@string/log_action_follow_bottom"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="@dimen/log_follow_btn_size"
                android:minHeight="@dimen/log_follow_btn_size"
                android:visibility="gone"
                app:icon="@drawable/ic_arrow_down"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="?attr/colorOnPrimary" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== 底部统计行：已读取行数 / 渲染上限，文件大小 / 尾读上限 ===== -->
    <TextView
        android:id="@+id/log_tail_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/log_loading"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

</LinearLayout>
