<?xml version="1.0" encoding="utf-8"?>
<!--
    一个配置键的行。四种 type（switch / int / multi / path）共用本布局，行根就是全项目唯一的换行容器
    WrapRowLayout：换行判据、行距、行内垂直居中全在容器里，本行不再自己算几何。
    子视图分三类（标记写在子标签的 app: 属性上，由容器在 inflate 时读出）：
      · 参数名（leading，缺省）：左起第一段。
      · 键内控件（trailing）：各输入框 / 各字段 / 开关——由 ConfigKeyRow 建好后 addView + setTrailing
        （switch 型的开关就是下面这个 config_key_switch，标记直接写在标签上）。
      · 说明 / 备注 / 状态（fullLine）：各占一行、按整行宽折行；不可见者容器会跳过，不留空行。
    本行在分组卡 body 里也整行独占：app:wrapFullLine 由 body 读出（参数之间不并排，并排/换行
    只发生在键内部的字段之间）。

    行距 wrapRowGap 取 @dimen/space_xs(4dp)：说明 / 备注 / 状态三行原本各带 space_xs 的 topMargin，
    现在这段间距由容器按行距给。行距必须小于 body 的行距 @dimen/config_key_row_gap(6dp)，
    "同一个键的几行"与"键与键之间"才分得开——故容器缺省的行距（= 列距 space_m）在这里要显式压低。

    开关的负 end 外边距是"把缩放 0.75 后墨迹两侧的空白还出去"（见 @dimen/switch_trim_end）：
    尾段右对齐算的是含外边距的宽，负的 end 外边距让开关的墨迹正好贴行尾。

    开关的高度不写 wrap_content：M3 的 MaterialSwitch 样式里 android:minHeight=?attr/minTouchTargetSize
    （48dp）是"触控尺寸"，会把开关键行撑到 48dp——比只有输入框的行（@dimen/field_height 36dp）高出一截。
    定高 @dimen/field_height 与输入框同高；轨道本体 32dp、缩放 0.75 后墨迹 24dp，定高不裁切。
    android:gravity="center_vertical" 是同一件事的另一半：SwitchCompat 按 gravity 落轨，缺省（TOP）
    会把轨道停在盒顶，缩放后墨迹落到盒中心上方约 1.5dp；写了才与行中心同心（也与参数名同轴）。
-->
<com.example.waspwingtempctrl.ui.WrapRowLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:wrapFullLine="true"
    app:wrapRowGap="@dimen/space_xs">

    <TextView
        android:id="@+id/config_key_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/app_on_surface"
        android:textSize="@dimen/text_body" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/config_key_switch"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/field_height"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginEnd="@dimen/switch_trim_end"
        android:gravity="center_vertical"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:visibility="gone"
        app:wrapTrailing="true" />

    <TextView
        android:id="@+id/config_key_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
        android:visibility="gone"
        app:wrapFullLine="true" />

    <TextView
        android:id="@+id/config_key_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
        android:visibility="gone"
        app:wrapFullLine="true" />

    <TextView
        android:id="@+id/config_key_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
        android:visibility="gone"
        app:wrapFullLine="true" />
</com.example.waspwingtempctrl.ui.WrapRowLayout>
