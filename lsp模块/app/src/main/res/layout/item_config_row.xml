<?xml version="1.0" encoding="utf-8"?>
<!--
    一个配置键的行。四种 type（switch / int / multi / path）共用本布局：
      第一行 = 参数名 + 输入框（或在右侧的开关），行内垂直居中；多值键的多个输入框放在
      config_key_control（流式容器）里，放不下时在键内自行换行。
      每个键都整行独占（由 ConfigKeyRow 向 FlowWrapLayout 声明）：参数之间不再并排，
      并排/换行只发生在键内部的字段之间（config_key_control）。
      desc / 单位说明 / 状态文字放第一行下方，宽度 wrap_content：短时只有文字那么宽，长时自然折行。
      "未生效"的标注在分组卡头做一次（见 item_config_group），行内只压暗不重复标注。

    参数名的对齐（两种键型统一走一套）：
      · 参数名装在一个定高 @dimen/field_height(36dp) 的盒子里、盒内垂直居中，盒子在行内贴顶——
        于是参数名的中心与「同一行第一个输入框」的中心重合。不能直接让行内居中：输入框下面还有
        说明行，按整行居中会把参数名一起压低（要求"不含说明内容的高度"）。
      · 控制区（输入框 / 开关）顶到行尾：参数内容输入框右侧对齐，参数名留在左边、宽度由内容决定。
        控制区自己吃 weight（0dp + weight=1）——框架在按 weight 分配时会先把参数名与那 8dp 外边距
        从行宽里扣掉，控制区拿到的就是"行宽 − 参数名 − 间距"这个真实可用宽，内部字段再宽也只会被
        自己的宽度上限挡住，不会越出行右边界被裁。
        不能沿用"占位 Space 带 weight 顶到行尾"的老办法：LinearLayout 只要行内存在带 weight 的子视图，
        首轮测量其它子视图时传的 widthUsed 就是 0，控制区会拿到接近整行的宽（参数名那一段从未被扣掉）
        → 数值框右半截、path 框大部分都落到屏幕外。path 键的输入框是 MATCH_PARENT（吃掉控制区剩余宽），
        宽度算对了它才不会越界。
      · config_key_spacer 的 weight 只服务开关键（把开关顶到行尾，与输入框键的右对齐观感一致）；
        键内有控制区时由 ConfigKeyRow 把它的 weight 撤成 0，否则两者各分一半剩余宽、控制区只剩一半。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/config_key_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/field_height"
            android:layout_gravity="top">

            <TextView
                android:id="@+id/config_key_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="@color/app_on_surface"
                android:textSize="@dimen/text_body" />
        </FrameLayout>

        <Space
            android:id="@+id/config_key_spacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.example.waspwingtempctrl.ui.FlowWrapLayout
            android:id="@+id/config_key_control"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:visibility="gone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/config_key_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/switch_trim_end"
            android:scaleX="0.75"
            android:scaleY="0.75"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/config_key_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
        android:visibility="gone" />

    <TextView
        android:id="@+id/config_key_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
        android:visibility="gone" />

    <TextView
        android:id="@+id/config_key_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:layout_marginBottom="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
        android:visibility="gone" />
</LinearLayout>
