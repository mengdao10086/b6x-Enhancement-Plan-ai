<?xml version="1.0" encoding="utf-8"?>
<!-- 状态页（外壳自带的初始页）。 -->
<!--
    根用 PageScrollView（ScrollView 子类，未指定 captor 时行为与普通 ScrollView 完全一致）：
    「操作记录」展开后是个定高内部滚动区，纵向拖动落在它上面时必须让给它——
    普通 ScrollView 在 ACTION_MOVE 一到 slop 就先把事件流截走，内层永远拿不到。见 StatusFragment。
-->
<com.example.waspwingtempctrl.ui.PageScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/status_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fadeScrollbars="false"
    android:fillViewport="true"
    android:scrollbarSize="@dimen/scrollbar_size"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/status_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="0dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="@dimen/page_padding">

        <!-- ===== 部署状态 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_section_deploy"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

                <!--
                    换字叠放层：新旧两段文本重叠放，业务上屏零延迟、视觉上旧的在下淡出新字在上淡入
                    （交叉淡入）。外层本可省去，但叠加必须有一个 FrameLayout 承载。
                    两段各自带 marginTop（保持与原 status_text 完全一致的排版：本层自身不加 margin，
                    高度 = 文本高 + marginTop）；status_text 在后 = 绘制在上层。
                    outgoing 是纯装饰层：默认 gone、不可选、不参与无障碍朗读，仅在换字那 100ms 露出。
                -->
                <FrameLayout
                    android:id="@+id/status_text_stack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/status_text_outgoing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:alpha="0"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:text="@string/status_loading"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                        android:textIsSelectable="true" />
                </FrameLayout>

                <!--
                    进度条常占位：从首帧起就占住这块高度（invisible 不是 gone），
                    显示/隐藏只有绘制差异、不动布局，故任何路径开关它都不会让下面两张卡上下跳。
                    初值必须是 invisible：用 gone 的话首帧高度就少一截，第一次刷新又会补上。
                -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/status_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/status_progress_gap"
                    android:indeterminate="true"
                    android:visibility="invisible" />

                <!--
                    按钮排布：行1 [一键部署][拉起daemon]、行2 [su诊断][刷新状态]、行3 [卸载部署][停止daemon]。
                    「刷新状态」与「su 诊断」同为点一次即出一段文本的动作，故同用 TextButton 样式。
                    行3 两个同为破坏性动作（都要二次确认、都会让温控增强失效），故同用 TextButton + state_error。
                    这 6 个按钮都是 M3 按钮样式，insetTop/insetBottom 各 4dp 会把可见圆角块上下各收 4dp，
                    故行间的可见空白 = margin + 8dp（调 margin 的观感与数值不成比例，细则见 dimens_status.xml）。
                    四处可见空白：
                      · 部署状态文本 → 进度条：0dp，走 status_progress_gap（进度条无 inset，margin 即所见）
                      · 进度条 → 行1：5dp，走 status_buttons_gap（上方不挨按钮，同理 margin 即所见）
                      · 行1 → 行2：3dp，走 status_button_row_gap（margin 取 -5dp）
                      · 行2 → 行3：0dp，走 status_button_last_gap（margin 取 -8dp）
                    后两处目标可见值不再相等，故各开一项；布局盒分别重叠 5dp / 8dp，
                    前一处的重叠小于两侧内缩之和 8dp、后一处正好等于，两行圆角块之间仍留 3dp / 0dp
                    （后一处圆角块刚好相接、仍不相碰），且上按钮圆角块的可点区不减少。
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/status_buttons_gap"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_deploy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_action_deploy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/status_action_start" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/status_button_row_gap"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_diag"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_action_diag" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_refresh"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/status_action_refresh" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/status_button_last_gap"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_uninstall"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_action_uninstall"
                        android:textColor="@color/state_error" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_stop"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_s"
                        android:text="@string/status_action_stop"
                        android:textColor="@color/state_error" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 设备与版本 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_section_device"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

                <TextView
                    android:id="@+id/info_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 操作记录（默认折叠：记录会越来越长，需要时才展开） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m">

            <!--
                内层容器不加 padding（同诊断卡）：padding 由卡头行与正文区各自承担。
                这样卡头行的点击波纹才铺满整卡宽度（挂在内层容器上会左右各内缩 12dp），
                折叠态的高度也不会在卡头内边距之外多出一段。
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 卡头整行可点：展开/收起操作记录 -->
                <LinearLayout
                    android:id="@+id/action_log_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/card_padding"
                    android:minHeight="@dimen/row_min_height"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_section_actions"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

                    <!-- 一副图标两种状态（同配置页分组卡头）：字符「▸/▾」的字形度量会把三角顶部裁掉 -->
                    <ImageView
                        android:id="@+id/action_log_arrow"
                        android:layout_width="@dimen/arrow_box"
                        android:layout_height="@dimen/arrow_box"
                        android:layout_marginStart="@dimen/space_s"
                        android:contentDescription="@string/config_action_expand"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_triangle"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <!--
                    正文区：自适应高、无内部滚动，与配置·曲线页诊断卡同款——
                    卡头↔正文 0dp 间距（不加 marginTop），正文只留 start/end/bottom 内边距，
                    故正文左边界与卡头标题对齐，折叠/展开都不多留一段。
                    代价（用户已知情接受）：记录只增不减，正文上限 8000 字符，展开后页面会被拉长。
                -->
                <LinearLayout
                    android:id="@+id/action_log_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:paddingBottom="@dimen/card_padding"
                    android:visibility="gone">

                    <!--
                        归档提示行：只在展开体里，故折叠时随本容器一起隐藏（用户口径）。
                        左右不另加内边距（本容器已有 card_padding），使其与下方正文左边界对齐。
                    -->
                    <TextView
                        android:id="@+id/action_log_archive_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="@dimen/space_s"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
                        android:textColor="@color/app_on_surface_variant"
                        android:textIsSelectable="true" />

                    <TextView
                        android:id="@+id/action_log_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                        android:textIsSelectable="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</com.example.waspwingtempctrl.ui.PageScrollView>
