<?xml version="1.0" encoding="utf-8"?>
<!--
    参数重置栏（设置页内容顶部）。一张卡：标题 + 一行说明 + 一组「分组名」按钮。
    按钮由 ConfigResetBar 按 store.groups() 逐个生成（一个分组一个按钮），本文件只给容器：
    分组数量与组名都不在这里手抄，改定义不必改本文件。
    卡片样式来自主题 materialCardViewStyle（Widget.B6XTempCtrl.Card），本文件不写死颜色/圆角。
    按钮容器用 FlowWrapLayout：分组名在窄屏一行放不下，靠它自动换行（列距固定 @dimen/space_m，
    行距单独收到 @dimen/space_s —— 按钮之间的行距小于参数行之间的间距更紧凑）。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/config_reset_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/config_reset_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_reset_title"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

        <TextView
            android:id="@+id/config_reset_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/config_reset_hint"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

        <com.example.waspwingtempctrl.ui.FlowWrapLayout
            android:id="@+id/config_reset_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:flowRowGap="@dimen/space_s" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
