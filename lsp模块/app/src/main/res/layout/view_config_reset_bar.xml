<?xml version="1.0" encoding="utf-8"?>
<!--
    参数重置栏（设置页内容末尾：在「界面」分组卡之后）。一张卡：标题 + 一组「分组名」按钮。
    按钮由 ConfigResetBar 按 store.groups() 逐个生成（一个分组一个按钮），本文件只给容器：
    分组数量与组名都不在这里手抄，改定义不必改本文件。
    卡片样式来自主题 materialCardViewStyle（Widget.B6XTempCtrl.Card），本文件不写死颜色/圆角。
    按钮容器用 FlowWrapLayout：分组名在窄屏一行放不下，靠它自动换行（列距固定 @dimen/space_m，
    行距单独收到 @dimen/space_s —— 按钮之间的行距小于参数行之间的间距更紧凑）。
    标题到按钮组只有这一段间距，由按钮组的 marginTop 独自承担，取 space_s(8dp)：
    原先中间夹着一行说明时，说明的 marginTop(space_xs 4dp) 与按钮组的 marginTop 各管一段，
    删掉说明后按钮组的 marginTop 即全部间距——若跟着改成 4dp 会偏紧，故保持既有 space_s 口径。

    本卡自带 @dimen/space_m 上间距，与分组卡（item_config_group.xml 同用 space_m）同一标尺：
    重置栏现在落在参数卡之后，卡与卡的间隙须由它自己给出。原在内容首位时无需此值——
    那时与上方内容的间隙由紧邻分组卡的上间距代劳，本卡再加就是双份留白。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/config_reset_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/config_reset_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_reset_title"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

        <com.example.waspwingtempctrl.ui.FlowWrapLayout
            android:id="@+id/config_reset_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            app:flowRowGap="@dimen/space_s" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
