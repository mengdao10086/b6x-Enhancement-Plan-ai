<?xml version="1.0" encoding="utf-8"?>
<!--
    曲线区（合并进配置页，挂在 fragment_config.xml 的 config_chart_container 下）。
    按要求「曲线/时间/图例/数据展示在视觉上不要分窗口」：本区只用一张卡，卡内自上而下四段——
      ① 时间窗口档位按钮 → ② 图例 6 项（按自然宽排布，装不下向下换行）→ ③ 曲线画布
      → ④ 画布下沿拖柄（拖动改画布高）。
    四段一律按自然尺寸排布：不做任何缩放，也不改写容器高度（原「整块缩放到 0.5 并覆写
    chart_tools_clip 高度」的做法已删，见 ChartFragment）。
    卡内不出现第二块底色/描边/圆角：画布自身不铺底色，与卡片底色连成一片（见 ChartView#onDraw）。

    高度一律不许用 weight（本区在配置页的 ScrollView 里，weight 会被量成 0），
    故画布高度初值取 @dimen/chart_canvas_height；拖动只在运行时改容器 LayoutParams，
    不落盘、不进 dimen（见 ChartFragment#onHandleTouch）。

    读取失败时不进画布，把 AppFiles.diagnose() 原文铺在曲线区，绝不静默留白。
    原独立成页时的顶部「数据文件」信息条与页面内边距已移走：信息条并入配置页「诊断信息」
    头部（ChartFragment 经 ChartFragment.Host 回调交给配置页渲染），页面内边距由配置页给。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_s"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="0dp">

            <!-- ===== ① 时间窗口档位：一行自然宽，不缩放 ===== -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/chart_window_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />

            <!--
                ===== ② 图例：按自然尺寸排布，放不下自动换行（窄屏也全部可见，不缩放不裁切） =====
                用配置页同一套可换行容器：项目里只保留一种换行实现，也不依赖 GridLayout 的
                「columnCount 是否会自动另起一行」这一行为（该行为未在本机核实过）。
                行距单给 chart_legend_row_gap（配置页仍是默认的 space_m），列距与图例项的
                layout_marginEnd 都不动。
                行首不靠自然宽碰运气：前四条（电池/制冷/风扇/热端）排第一行，「冷端℃」「CPU℃」按
                ChartSeries#startsLegendRow 经 FlowWrapLayout#setBreakBefore 固定另起第二行——
                这两条是可选的温度传感器，与上面四条不是一类。
            -->
            <com.example.waspwingtempctrl.ui.FlowWrapLayout
                android:id="@+id/chart_legend_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chart_row_gap"
                app:flowRowGap="@dimen/chart_legend_row_gap" />

            <!--
                ===== ③ 画布 / 读取失败诊断 =====
                容器高度就是画布高（拖柄改的正是它）。画布下沿不再贴卡片底——其下还有拖柄触控带，
                故「最低一条网格线 → 卡片下沿」= PAD_B_DP(4dp) + chart_resize_band_height(8dp) = 12dp，
                这 12dp 被拖柄横条一分为二，见 ④。
            -->
            <FrameLayout
                android:id="@+id/chart_canvas_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chart_canvas_height"
                android:layout_marginTop="@dimen/chart_row_gap">

                <com.example.waspwingtempctrl.ui.ChartView
                    android:id="@+id/chart_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ScrollView
                    android:id="@+id/chart_failure_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fadeScrollbars="false"
                    android:padding="@dimen/card_padding"
                    android:scrollbarSize="@dimen/scrollbar_size"
                    android:scrollbars="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/chart_failure_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
                        android:textIsSelectable="true" />
                </ScrollView>
            </FrameLayout>

            <!--
                ===== ④ 画布下沿拖柄（拖动改画布高，由 ChartFragment 处理） =====
                外层整条 chart_resize_band_height(8dp) 是触控带：横条只有 4dp 高，直接拿它当触控目标按不准；
                内层横条贴触控带顶部并水平居中（layout_gravity=top|center_horizontal）：只写 top 会连
                水平居中一起丢掉（FrameLayout 的 center 同时管两个方向），横条会贴到左边去。
                贴顶后横条上沿与画布下沿齐平，横条上下两侧的空白因此相等：上侧到画布最下面那条网格线
                = ChartView 的 PAD_B_DP(4dp)，下侧到卡片下边界（本带下沿，内层 paddingBottom=0）
                = 8 − 4 = 4dp。代价是触控带由 12dp 缩到 8dp，触控面积随之变矮（原值一路是
                space_xl 24dp → 12dp → 8dp，前两次压缩的理由见 dimens_chart.xml）。
                横条不可点（View 默认即不可点，这里写明是为了别挡住触控带的事件）。
                纵向拖动才回给本带（横向交给外层 ViewPager2 翻页）：由本页所在的 PageScrollView
                在按下点落在本带上时不接管纵向拖动，见 PageScrollView#setVerticalDragCaptor。
            -->
            <FrameLayout
                android:id="@+id/chart_resize_handle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/chart_resize_band_height">

                <View
                    android:layout_width="@dimen/chart_resize_bar_width"
                    android:layout_height="@dimen/chart_resize_bar_height"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/bg_chart_resize_bar"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
