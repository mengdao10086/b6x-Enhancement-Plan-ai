<?xml version="1.0" encoding="utf-8"?>
<!--
    路径短按小卡（TextCopy.PathActionCard）：只有「复制 / 跳转」两个动作，不重复显示路径文本。
    宽高随内容；由 PopupWindow 贴在被点路径那一行的上方（放不下翻到下方），窗口不压暗背景。
    卡片外观沿用主题 materialCardViewStyle。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/card_radius">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_xs">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/path_card_copy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/path_action_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/path_card_open"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/path_action_open" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
