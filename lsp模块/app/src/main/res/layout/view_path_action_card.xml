<?xml version="1.0" encoding="utf-8"?>
<!--
    路径短按小卡（TextCopy.PathActionCard）：一条路径 +「复制 / 跳转」两个动作。
    宽由代码设为固定的紧凑宽度（上限屏宽 − 48dp），路径最多两行、超长只在中间省略；
    卡片外观沿用主题 materialCardViewStyle。窗口背景由代码设为透明，点卡外或返回键即收起。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/card_radius">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <TextView
            android:id="@+id/path_card_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Mono"
            android:textDirection="ltr" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_xs"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/path_card_copy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/path_action_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/path_card_open"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/path_action_open" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
