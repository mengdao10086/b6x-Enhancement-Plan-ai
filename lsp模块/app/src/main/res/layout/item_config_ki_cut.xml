<?xml version="1.0" encoding="utf-8"?>
<!--
    KI 分段倍率表整块（挂在键行 WrapRowLayout 的 fullLine 位上）：
      簇块容器（KiCutTableEditor 往里塞 item_ki_cut_cluster.xml）→ 实时倍率曲线 → 图例。
    这里只摆静态骨架；簇/点全部由 KiCutTableEditor 现场增删（「添加簇」已移入每个簇块底部）。
    图例（三条倍率线的色块 + 红色竖虚线色块）压在曲线下方一行、整行居中，去掉 4dp 上距以紧凑排布
   （字号/色块维持 Caption 12sp 与 10dp，本轮曾压小，按真机反馈改回原值）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ki_cut_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ki_cut_clusters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 0 簇空态：簇可删到一个不剩（＝全段全 100），但每簇块底部的「添加簇」也随之消失，
         故空态自带一枚补回入口。仅 blocks 为空时可见（KiCutTableEditor#refreshButtons 切）。 -->
    <LinearLayout
        android:id="@+id/ki_cut_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/config_ki_cut_empty_hint"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ki_cut_empty_add"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ki_cut_del_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:text="@string/config_ki_cut_add_cluster"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <com.example.waspwingtempctrl.ui.KiCutChartView
        android:id="@+id/ki_cut_chart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ki_cut_chart_height"
        android:layout_marginTop="@dimen/space_xs" />

    <!-- 图例：三条线的颜色（KDP / 升 / 降，按表内列序）+ 红色竖虚线（当前冷值）；整行居中、紧凑 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/ki_cut_legend_swatch"
            android:layout_height="@dimen/ki_cut_legend_swatch"
            android:background="@color/ki_cut_kdp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_m"
            android:text="@string/config_ki_cut_legend_kdp"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

        <View
            android:layout_width="@dimen/ki_cut_legend_swatch"
            android:layout_height="@dimen/ki_cut_legend_swatch"
            android:background="@color/ki_cut_up" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_m"
            android:text="@string/config_ki_cut_legend_up"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

        <View
            android:layout_width="@dimen/ki_cut_legend_swatch"
            android:layout_height="@dimen/ki_cut_legend_swatch"
            android:background="@color/ki_cut_down" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_m"
            android:text="@string/config_ki_cut_legend_down"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

        <View
            android:layout_width="@dimen/ki_cut_legend_swatch"
            android:layout_height="@dimen/ki_cut_legend_swatch"
            android:background="@color/ki_cut_target" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/config_ki_cut_legend_target"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />
    </LinearLayout>
</LinearLayout>
