<?xml version="1.0" encoding="utf-8"?>
<!--
    KI 分段削减表整块（挂在键行 WrapRowLayout 的 fullLine 位上）：
      簇块容器（KiCutTableEditor 往里塞 item_ki_cut_cluster.xml）→「添加簇」→ 图例 → 实时倍率曲线 → 横轴说明。
    这里只摆静态骨架；簇/点全部由 KiCutTableEditor 现场增删。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ki_cut_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ki_cut_clusters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ki_cut_add_cluster"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ki_cut_del_size"
        android:minWidth="0dp"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:text="@string/config_ki_cut_add_cluster"
        android:textSize="@dimen/text_caption" />

    <!-- 图例：两条线的颜色 + 红色竖虚线（此刻目标冷值） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="@dimen/ki_cut_legend_swatch"
            android:layout_height="@dimen/ki_cut_legend_swatch"
            android:background="@color/ki_cut_up" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_m"
            android:text="@string/config_ki_cut_legend_up"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

        <View
            android:layout_width="@dimen/ki_cut_legend_swatch"
            android:layout_height="@dimen/ki_cut_legend_swatch"
            android:background="@color/ki_cut_down" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:layout_marginEnd="@dimen/space_m"
            android:text="@string/config_ki_cut_legend_down"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

        <View
            android:layout_width="@dimen/ki_cut_legend_swatch"
            android:layout_height="@dimen/ki_cut_legend_swatch"
            android:background="@color/ki_cut_target" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:text="@string/config_ki_cut_legend_target"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />
    </LinearLayout>

    <com.example.waspwingtempctrl.ui.KiCutChartView
        android:id="@+id/ki_cut_chart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ki_cut_chart_height"
        android:layout_marginTop="@dimen/space_xs" />

    <TextView
        android:id="@+id/ki_cut_axis_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />
</LinearLayout>
