<?xml version="1.0" encoding="utf-8"?>
<!--
    分段倍率表的一个「簇」块：表头（"簇 N" + 模式态提示）+ 点行/插入横线容器 + 底部动作行
    （"添加点" "添加簇" "拆分簇" …空档… "删除簇"，删除簇在最右）。
    点行与插入横线由 KiCutTableEditor 现场 inflate item_ki_cut_point.xml / item_ki_cut_insert_line.xml
    后 addView 进 ki_cut_cluster_points（横线与行交替）。块底色取 app_surface_container_high
    （比卡片底色亮一档），簇与簇之间自然分得开。去空气：块内不设内边距、底部行不设上距、块与块之间不留下外边距。

    四个 MaterialButton 的垂直内边距与 inset 都显式归零，原因见 item_ki_cut_point.xml 顶部注释：
    M3 TextButton 样式自带 paddingTop/Bottom=6dp 与 insetTop/Bottom=4dp，而 MaterialButtonHelper 会把
    inset 叠进 padding（padding += inset），二者相加 = 上下各 10dp；框高 30dp 时内容盒只剩 10dp，
    装不下 12sp 文字的行盒 → 只露上半边。显式写 0dp 后内容盒 = 30dp，文字完整居中。
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ki_cut_cluster"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_surface_container_high"
    android:orientation="vertical">

    <!-- 表头行：「簇 N」+ 模式态提示（同一行、紧跟簇名）；2dp 下内边距给首条横线上抬让位
         （否则首条横线顶到标题、第 1 行的浮起列名不够露）。是本块唯一的内部留白，其余仍不设内边距。
         提示 TextView（ki_cut_split_hint）常态 GONE → 不占任何高度（模式退出后不留空）；进模式才可见，
         文字接在簇名之后、放不下自动折到第二行（不另占按钮行之下的一整行）。由 KiCutTableEditor 切文案/显隐。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/ki_cut_cluster_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />

        <TextView
            android:id="@+id/ki_cut_split_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_s"
            android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ki_cut_cluster_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- 底部动作行：添加点 / 添加簇 / 拆分簇 同一行（无上距），删除簇顶到最右 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ki_cut_cluster_add_point"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ki_cut_del_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:text="@string/config_ki_cut_add_point"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ki_cut_cluster_add_cluster"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ki_cut_del_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:text="@string/config_ki_cut_add_cluster"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ki_cut_cluster_split"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ki_cut_del_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:text="@string/config_ki_cut_split_cluster"
            android:textSize="@dimen/text_caption" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ki_cut_cluster_del"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ki_cut_del_size"
            android:contentDescription="@string/config_ki_cut_del_cluster"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:text="@string/config_ki_cut_del_cluster_text"
            android:textColor="@color/ki_cut_del"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</LinearLayout>
