<?xml version="1.0" encoding="utf-8"?>
<!--
    图例项：勾选框（着色 = 该曲线的 chart_series_* 色，运行时按主题取）。
    尺寸基准（k=1）：文字 14sp（TextAppearance.B6XTempCtrl.Legend，Caption 被别处复用，不能全局改）、
    勾选框方框 16dp、相邻项总间距 4dp（WrapRowLayout colGap 置 0 + 本项 layout_marginEnd 4dp）、
    项高 18dp。ChartFragment 在窄屏按统一比例 k 重设字号/方框/间距/行高（不用 setScaleX/Y）。
    高度：includeFontPadding=false 后 14sp 文字行高约 16dp，minHeight 18dp 成为实际下限；
    这个值现在真的生效：buttonCompat 指向自绘的 ic_chart_legend_box（固有 18dp 图，运行时由
    ChartFragment 用 16dp × k 的包装 drawable 重设），CompoundButton 给勾选框设的最小高随之变化。
    minWidth=0dp 去掉 Material 复选框样式的 48dp 横向地板，否则窄屏等比缩小会被它顶住；
    代价是触控宽高更小（见验收报告的触控风险）。
    用 buttonCompat 而非 android:button：AppCompatCompoundButtonHelper 先判 buttonCompat、命中即
    setButtonDrawable 并跳过 android:button，且它在框架构造函数之后执行，最后落地的就是这份 drawable。
    本项不决定自己落在哪一行：图例的行首（pid ℃ 固定另起第二行）由 ChartSeries#startsLegendRow
    经 WrapRowLayout#setBreakBefore 施加，见 fragment_chart.xml 的 ② 段。
    颜色由勾选框自己的 buttonTint（M3 样式的 m3_checkbox_button_tint）着色，两态自动跟深浅色主题；
    选中态的对勾走挖空、透出卡片底色，深色主题下对比度略低于 material 的 onPrimary 对勾。
-->
<CheckBox xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chart_legend_check"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/chart_legend_item_gap"
    android:includeFontPadding="false"
    android:minHeight="@dimen/chart_legend_item_height"
    android:minWidth="0dp"
    android:paddingStart="0dp"
    android:paddingTop="0dp"
    android:paddingEnd="0dp"
    android:paddingBottom="0dp"
    android:textAppearance="@style/TextAppearance.B6XTempCtrl.Legend"
    app:buttonCompat="@drawable/ic_chart_legend_box" />
