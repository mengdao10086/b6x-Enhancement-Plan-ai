<?xml version="1.0" encoding="utf-8"?>
<!--
    图例项：勾选框（着色 = 该曲线的 chart_series_* 色，运行时按主题取）。
    高度收到 chart_legend_item_height(24dp，≈ 勾选框 + 一行文字的自然高)：默认走 Material 复选行的
    48dp 触控高，6 项在窄屏会摊成三行、占掉一大块曲线区；这里与图例的"轻量开关"定位一致。
    不再与档位按钮共用尺寸：档位按钮另有 chart_window_button_height(21dp)，两者已解耦。
-->
<CheckBox xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chart_legend_check"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_xs"
    android:minHeight="@dimen/chart_legend_item_height"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:textAppearance="@style/TextAppearance.B6XTempCtrl.Caption" />
