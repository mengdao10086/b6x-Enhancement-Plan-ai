<?xml version="1.0" encoding="utf-8"?>
<!--
    一个分组卡片 = 卡头（标题 + "未生效"徽标 + 组头开关 + 展开箭头）+ 分隔线 + 键行容器。
    卡片样式来自主题 materialCardViewStyle（Widget.B6XTempCtrl.Card），本文件不写死颜色/圆角。
    组头开关只在 role=master 的组出现；webui 组已搬到设置页（ConfigGroupBinder 仍支持 master 为 null）。
    徽标默认 gone：本组存在"依赖未满足"的键时由 ConfigGroupBinder 显示一次（行内不再逐键标注）。

    卡头高度写死 @dimen/row_min_height(48dp)：不带开关的诊断卡头也是 48dp，两者必须同高。
    箭头是 24dp 图标盒、开关自身约 32dp，都小于 48dp，行内垂直居中即完整可见，不会被裁。
    展开三角用 ImageView 承载矢量图标（drawable/ic_triangle.xml）——「▸/▾」字符的字形度量会把
    三角顶部裁掉。
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/config_group_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/config_group_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/row_min_height"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/config_group_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.B6XTempCtrl.SectionTitle" />

            <TextView
                android:id="@+id/config_group_badge"
                style="@style/Widget.B6XTempCtrl.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/config_badge_inactive"
                android:visibility="gone" />

            <!--
                "界面自用，守护进程不读取"：与"未生效"同一位置、同一套样式，也是整组只标一次。
                本组（全部键都不被守护进程读取，如设置页的界面组）由 ConfigGroupBinder 显示它，
                组内各行不再各贴一遍。
            -->
            <TextView
                android:id="@+id/config_group_ui_badge"
                style="@style/Widget.B6XTempCtrl.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/config_ui_only"
                android:visibility="gone" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/config_group_master"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_marginEnd="@dimen/switch_trim_end"
                android:scaleX="0.75"
                android:scaleY="0.75"
                android:visibility="gone" />

            <!-- 收起态指右；展开态由 ConfigGroupBinder 旋转 90° 指下 -->
            <ImageView
                android:id="@+id/config_group_arrow"
                android:layout_width="@dimen/arrow_box"
                android:layout_height="@dimen/arrow_box"
                android:layout_marginStart="@dimen/space_xs"
                android:contentDescription="@string/config_action_expand"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_triangle"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <View
            android:id="@+id/config_group_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:background="@color/app_outline_variant"
            android:visibility="gone" />

        <!-- 键行容器是流式布局：每个键都整行独占（ConfigKeyRow 对每个键都声明 fullLine），
             保留流式容器是为了让键内部的多个字段自行并排/换行（见 WrapRowLayout） -->
        <com.example.waspwingtempctrl.ui.WrapRowLayout
            android:id="@+id/config_group_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="@dimen/space_s"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding"
            android:visibility="gone"
            app:wrapRowGap="@dimen/config_key_row_gap" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
