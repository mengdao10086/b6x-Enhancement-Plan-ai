<?xml version="1.0" encoding="utf-8"?>
<!--
    配置页专属尺寸。能用 values/dimens.xml 的共用标尺就不要在这里新增
    （间距一律 @dimen/space_*、圆角 @dimen/field_radius/card_radius）。
-->
<resources>

    <!--
        "未生效"行的压暗透明度（1=不压暗）。它是最小可读性与"一眼看出未生效"之间的折中：
        再低会把标签压到看不清，再高就看不出差别。
    -->
    <item name="config_dim_alpha" format="float" type="dimen">0.55</item>

    <!--
        输入框宽度的自适应区间。
        下限：Material OutlinedBox 的内容内边距（左右各约 16dp）加上短 hint（"数值"）本身，
              再窄就会挤压数字本身；上限：最长的一句话说明（如"每遍权重α(×100)"）量出来约
              200dp，再放宽就把同一行的其它字段全挤到下一行，流式排布退化成"每字段一行"。
        实际宽度由 ConfigKeyRow 取「hint 宽」与「内容宽 + 两个小写字符」的大者后钳进本区间，
        再按控制区的实际可用宽分配：同键多字段一起去分，分不下去就从最宽的开始削——但每个字段都削不动
        自己那道地板 max(本下限, 该字段 hint 宽 + 左右内边距)。地板必须把 hint 算进去：说明的可用宽正是
        "框宽 − 左右内边距"，框窄到装不下说明时 material 只能打省略号（"最高转…"就是这么来的）。
        削到地板仍不够就交给流式容器换行——宁可多占一行，也不把说明截断。
        path 键不走本区间：它按 MATCH_PARENT 吃掉控制区剩余宽（路径长度差别极大，截断的代价高于占宽）。
    -->
    <dimen name="config_field_min_width">72dp</dimen>
    <dimen name="config_field_max_width">240dp</dimen>
    <!--
        输入框字号：与 @dimen/log_filter_text_size 同为 16sp，对应 @dimen/field_height 的 36dp
        （两处输入框要求等高，字号也必须同档，否则等高之下一个显空一个显挤）。
    -->
    <dimen name="config_field_text_size">16sp</dimen>

    <!--
        输入内容的上内边距（下内边距见 @dimen/config_field_pad_bottom，2dp）。
        内层 EditText 是 match_parent + 垂直居中：正文在"去掉内边距后的内容区"里居中，所以上下内边距
        不改变居中方式，只决定两件事——内容区可用高、以及内容区中心（= 正文落点）在框内的位置。
        落点相对框中心的偏移 = (padTop − padBottom) / 2：只与两者之差有关，与框高无关。
        浮起说明的纵向位置是 material 的定式（TextInputLayout，OUTLINED 分支）：说明可用框顶 =
        框顶 − 说明行盒高 / 2（calculateCollapsedTextBounds 配 calculateLabelMarginTop），即说明行盒
        正好骑在框顶那条边上，下沿落在框顶下 说明行盒高/2 处。我们没设 app:hintTextAppearance，
        说明与正文同字号（setEditText / onLayout 里 setExpandedTextSize(getTextSize())）——都是 16sp、
        行盒约 18.75dp，故说明下沿 ≈ 框顶下 9.375dp。
        算式（框高 @dimen/field_height 36dp、行盒约 18.75dp）：
          内容区 = [padTop, 36 − padBottom] = [5, 34]，可用高 29dp；
          行盒在内容区内居中 → 上下各留 (29 − 18.75) / 2 ≈ 5.125dp；
          行盒中心 = (5 + 34) / 2 = 19.5dp，行盒顶 10.125dp、行盒底 28.875dp。
        几何含义：
          · 比框的几何中心（36 / 2 = 18dp）低 1.5dp = (5 − 2) / 2 —— 参数名盒就装在几何中心上
            （见 item_config_row.xml），故正文与参数名的中心差 1.5dp。
          · 与上一版对照：5/3 与 6/4 的差值都是 2dp，落点都是 +1dp（两者完全等价）；本次 5/2 差值 3dp，
            落点真的下移 0.5dp 成 +1.5dp——改落点只能改差值，改上下和值只改内容区可用高。
          · 比「说明下沿(9.375) → 框底(36)」的中点 22.7dp 高 3.2dp，即正文略偏说明一侧。
          · 版面留白：说明下沿 → 行盒顶 ≈ 0.75dp，行盒底 → 框底 ≈ 7.125dp。
            这处"说明与正文之间的余量"是 36dp 框高下最薄的一处：6/4 时只有 0.25dp，改 5/2 后放宽到
            0.75dp（墨迹层面：说明 CJK 墨迹底 ≈ 框顶下 7.4dp，正文数字墨迹顶 ≈ 框顶下 13.6dp，约
            6.2dp 不相碰）。框高再压或说明行盒变高仍会先在这里相碰。
    -->
    <dimen name="config_field_pad_top">5dp</dimen>

    <!--
        输入内容的下内边距，只服务配置页这个输入框（item_config_field.xml 里 EditText 的 android:paddingBottom）。
        不直接用共用标尺 @dimen/space_xs：本项要能独立取值，就不与全局间距阶梯绑在一起（即使当前取值恰好相同）。
        与上内边距共同决定正文落点的算式见 @dimen/config_field_pad_top。
    -->
    <dimen name="config_field_pad_bottom">2dp</dimen>

    <!--
        参数（键行）之间的纵向间隔 = 分组卡默认行距 space_m(12dp) 的一半。
        卡内上下内边距仍是 space_s，只压键与键之间这一段。
    -->
    <dimen name="config_key_row_gap">6dp</dimen>

    <!--
        展开/收起三角的图标盒（也是箭头控件的宽高）。取 24dp：与分组卡头 / 诊断卡头的
        12dp 内边距相加正好 48dp，与 @dimen/row_min_height 一致；图标墨迹 12×14dp，
        居中后完整可见（同 drawable/ic_triangle.xml）。
    -->
    <dimen name="arrow_box">24dp</dimen>

    <!--
        开关缩放 0.75 后墨迹左右各内缩约 6dp（track 52dp → 39dp）。取负的 end 外边距把这圈
        空白还给布局：有 weight 的兄弟（键行里的占位 Space）会多分到这 6dp，开关贴到行尾；
        无 weight 的兄弟（卡头里的展开箭头）会左移 6dp，正好落进开关的空白里。
    -->
    <dimen name="switch_trim_end">-6dp</dimen>
</resources>
