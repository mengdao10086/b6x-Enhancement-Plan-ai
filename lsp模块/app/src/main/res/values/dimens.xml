<?xml version="1.0" encoding="utf-8"?>
<!--
    全界面共用尺寸标尺。三个界面子 agent 一律引用此处，不要写死 dp/sp，
    否则三页的间距与圆角会各走一套，观感立刻散。
    （曲线与日志里的"绘制用像素"由各自在 Java 里按 density 换算，不受此限。）
-->
<resources>

    <!-- 间距阶梯：4 的倍数 -->
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">12dp</dimen>
    <dimen name="space_l">16dp</dimen>

    <!-- 圆角 -->
    <dimen name="card_radius">12dp</dimen>
    <dimen name="chip_radius">8dp</dimen>
    <dimen name="field_radius">8dp</dimen>

    <!-- 页面与卡片内边距 -->
    <dimen name="page_padding">16dp</dimen>
    <dimen name="card_padding">12dp</dimen>

    <!-- 字号 -->
    <dimen name="text_body">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_mono">12sp</dimen>
    <!-- 展开/收起的三角已改用矢量图标（见 drawable/ic_triangle.xml），不再需要字号标尺 -->

    <!-- 控件 -->
    <dimen name="row_min_height">48dp</dimen>
    <dimen name="divider_height">1dp</dimen>
    <dimen name="badge_padding_h">6dp</dimen>
    <dimen name="badge_padding_v">2dp</dimen>

    <!--
        标题栏：大标题到窗口顶端的距离（标题原在 ?attr/actionBarSize 里垂直居中，上下各约 14dp → 这里减半取整）。
        到标题栏下边界的距离单独由 title_pad_bottom 决定：不再与到窗口左侧的距离共用 space_l，
        因为 space_l 同时是两页标题栏的左右内边距、还被日志页引用，改它会波及无关处。
        标题行内容高度由标题文本行高决定（TitleLarge 约 28dp），故标题栏总高约 4 + 28 + 8 = 40dp（不再是 51dp）。
        右侧设置按钮受同一行高约束，故取 28dp（图标 24dp）——比 48dp 触控规范小。
    -->
    <dimen name="title_pad_top">4dp</dimen>
    <!-- 标题栏下边界留白：8dp = 原 space_l(16dp) 的一半。左右内边距仍为 space_l。 -->
    <dimen name="title_pad_bottom">8dp</dimen>
    <dimen name="title_action_size">28dp</dimen>

    <!--
        滚动条：所有可滚动视图统一加粗并常显（取消自动淡出），配合 ui/ScrollbarDrag 才能按住拖动。
        宽度取原 6dp 的 2/3 = 4dp：拖动命中区另有 8dp 余量（ScrollbarDrag），窄一点更好按准内容。
    -->
    <dimen name="scrollbar_size">4dp</dimen>

    <!--
        底部页签栏：高度取 M3 默认 80dp 的 2/3 = 53dp（80dp 原是给活动指示器留的余量，本栏只有图标 + 标签）。
        条目上内边距取 12dp 的 2/3 = 8dp，保持不动（改它等于把图标整体上移，方向与下面相反）。
        条目下内边距：该值加在标签文字下方（文字 → 条目底边），原 11dp 时
        53 − 8(上内边距) − 24(图标) − 16(LabelMedium 12sp 行高) − 11(下内边距) = −6dp，
        即标签与图标本就重合 6dp；收到 3dp 等于把文字下移 8dp，重合变为留 2dp 间隙，
        语义从此是"文字贴条目底边、靠此值消除图标-文字重合"，不再是"与图标保持间距"。
        图标（24dp）与标签字号（12sp）不动；文字若再压到条目底边，只能抬 @dimen/bottom_nav_height。
    -->
    <!-- 同时是 ui/EdgeToEdge 的"基准内容高"：运行时 height 会变成 53dp + 系统条高（键盘弹起时回到 53dp）。 -->
    <dimen name="bottom_nav_height">53dp</dimen>
    <dimen name="bottom_nav_pad_top">8dp</dimen>
    <dimen name="bottom_nav_pad_bottom">3dp</dimen>

    <!-- 日志页 -->
    <dimen name="log_line_spacing">2dp</dimen>

    <!--
        输入框高度：日志关键词搜索框与配置页各输入框共用同一个值（要求两者等高）。
        Material3 OutlinedBox 单行默认约 56dp；给 36dp 比日志框原 37dp 只少 1dp，
        即回到压缩前那个量级（此前的 49dp 是把它按 4/3 放大出来的）。
        必须显式给 TextInputLayout 定高，否则压不过它内部按内容算出的高度；
        内层 EditText 的 minHeight 与垂直内边距同步收小，16sp 文字才放得下。
        风险：浮起说明骑在框顶那条边上、需在框顶之上占约 8dp，其下沿约在框顶下 8dp；
        框高压到 36dp 后正文行盒顶（见 @dimen/config_field_pad_top 的算式）离它只剩约 1.6dp，
        是否相碰、或被上层容器裁切，本机无设备无法确认，待真机核对。
    -->
    <dimen name="field_height">36dp</dimen>
    <!-- 搜索框字号：12sp × 4/3 = 16sp。不复用 text_mono，避免波及日志行本身。 -->
    <dimen name="log_filter_text_size">16sp</dimen>
    <!--
        搜索框到上方日志文件卡的上间距：4dp = space_s(8dp) 再收 4dp（原 6dp 再上移 2dp）。
        原用共用标尺 space_s，为单独收紧这段而单开此值——space_s 同时是搜索框左右缩进、
        命中计数行缩进、日志列表内边距与「回到底部」按钮边距，改它会牵动整页。
        该值只压搜索框上沿这一段：搜索框左右缩进仍走 space_s，不随此值变化。
    -->
    <dimen name="log_filter_gap">4dp</dimen>
    <!-- 「回到底部」纯图标按钮的触控尺寸。宽高相同 + Material3 全圆角 → 正圆。 -->
    <dimen name="log_follow_btn_size">48dp</dimen>
</resources>
