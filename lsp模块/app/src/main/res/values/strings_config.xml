<?xml version="1.0" encoding="utf-8"?>
<!--
    配置页（D1）与设置页文案。外壳/状态页的文案在 strings.xml，本文件只放本页自己的。
    同一份文案只在此处出现一次：布局与 Java 都引用资源名，不写重复字面量。
-->
<resources>

    <!-- ===== 合并页（配置 · 曲线） ===== -->
    <!-- 页签文案：曲线页已并入本页（页签由 4 个减为 3 个） -->
    <string name="config_tab_title">配置 · 曲线</string>

    <!-- ===== 定义加载失败的错误态 ===== -->
    <string name="config_error_title">参数定义加载失败</string>
    <string name="config_error_body">无法生成配置表单：应用内置的参数定义没有加载成功。以下为诊断信息。</string>
    <!-- 建表的"可见后段"失败：卡头已经露出来了，只在错误位补一句实话（不回退已露出的部分）。
         不带占位符：原始异常会露出类名与英文 message，不该铺给用户。 -->
    <string name="config_build_failed">参数行未建全（本页其余设置不受影响）。</string>

    <!-- ===== 分组卡头 ===== -->
    <!-- 展开/收起的三角是 drawable/ic_triangle.xml（字符字形会把三角顶部裁掉），故只剩无障碍描述两条 -->
    <string name="config_action_expand">展开本组</string>
    <string name="config_action_collapse">折叠本组</string>
    <!--
        bool 子字段的占位标签：params.json 里 PID_TARGET_DIR[0] / PID_SPEED_RECALL[0] /
        APP_LAUNCH_SCREEN_GATE[0] 的 label 字面就是它，与右边的开关控件本身重复，
        界面不再渲染这个词（其余有意义的 label 照常显示）。
    -->
    <string name="config_bool_label_placeholder">开关</string>
    <string name="config_group_ungrouped">未分组</string>
    <string name="config_group_badge_desc">本组有 %1$d 项依赖未开启，暂不生效</string>

    <!-- ===== 键行 ===== -->
    <string name="config_badge_inactive">未生效</string>
    <string name="config_ui_only">界面自用，守护进程不读取</string>
    <string name="config_hint_value">数值</string>
    <string name="config_hint_path">路径</string>
    <string name="config_range">范围 %1$s~%2$s</string>
    <string name="config_clamped">原值 %1$s → 已按定义范围钳制为 %2$s</string>
    <string name="config_input_restored">输入为空或不可解析，已恢复为上一次的值</string>
    <string name="config_path_note">路径提示：%1$s</string>

    <!-- ===== 设置页（[4] 界面 组的独立页，从顶栏设置按钮进入） ===== -->
    <string name="config_back_desc">返回上一页</string>
    <string name="config_settings_empty">参数定义里没有「界面」分组，本页暂无可调项</string>

    <!--
        参数重置栏（设置页内容末尾：在「界面」分组卡之后）。按钮上的组名不在这里：它由 ConfigResetBar 从分组标题
        去掉段标编号得到（与卡头同一口径），写死这 5 个组名就会与定义分家。
        重置基准是定义里的 factory（出厂值），不是 default（代码内默认值），故文案一律说"出厂值"。
    -->
    <string name="config_reset_title">参数重置</string>
    <string name="config_reset_dialog_title">重置「%1$s」？</string>
    <string name="config_reset_dialog_message">该组参数将恢复出厂值：组头总开关与组内全部参数一起回到出厂值，此操作不可撤销。</string>
    <string name="config_reset_confirm">恢复出厂值</string>
    <string name="config_reset_cancel">取消</string>
    <string name="config_reset_done">「%1$s」已恢复出厂值</string>
    <string name="config_reset_no_change">「%1$s」已经是出厂值，未写入</string>
    <string name="config_reset_failed">重置「%1$s」失败：%2$s</string>

    <!-- ===== 诊断区 ===== -->
    <string name="config_diag_title">诊断信息</string>
    <string name="config_diag_mtime">配置 mtime：%1$s</string>
    <string name="config_diag_mtime_missing">配置 mtime：配置文件不存在</string>
    <!--
        自检口径 = 每个定义键都要有可编辑入口，三处入口相加应等于定义键数：
          本页 = 本页键行（role=setting，不含 webui 组）
          设置页 = webui 组的键（搬到独立设置页，来源同 UiSettingsFragment.webuiKeys()）
          组头开关 = role=master 的键（由 ConfigGroupBinder 渲染成卡头开关）
    -->
    <string name="config_diag_render_ok">键渲染自检：本页 %1$d + 设置页 %2$d + 组头开关 %3$d = 定义 %4$d 项</string>
    <string name="config_diag_render_mismatch">键渲染自检：本页 %1$d + 设置页 %2$d + 组头开关 %3$d ≠ 定义 %4$d 项（键表可能已变更）</string>
    <string name="config_diag_action_refresh">刷新诊断</string>
    <string name="config_unknown_keys">配置含未定义键（界面不显示，写入时也不会改动）：%1$s</string>
</resources>
