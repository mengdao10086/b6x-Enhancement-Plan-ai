<?xml version="1.0" encoding="utf-8"?>
<!--
    分段倍率表（编辑器）自用尺寸。
    此键族的既有条目都写在 G 包独占的 dimens_config.xml 里，本包不得改那个文件，
    故本包新增的尺寸一律集中在此（既有条目仍只读引用 dimens_config.xml）。
-->
<resources>
    <!-- 点行四个数字框的高与字号：常态 36dp，**与同页其它带列名的参数输入框同高**
         （那类框的高＝@dimen/field_height 36dp，见 values/dimens.xml；字号＝@dimen/config_field_text_size 16sp）。
         两者取同值后，本表的框与「远离基线 a(%)」等框逐值等高、列名基线也一致。 -->
    <dimen name="ki_cut_point_height">36dp</dimen>
    <!-- 模式态（插入/拆分）框高：＝常态 36dp − 横线占用高度 6dp = 30dp，故「框 + 线」合计仍 36dp，逐行与常态等高、整表总高不变。
         列名保持显示（不再关）：框体顶部有 material 给浮起说明预留的 ≈7dp 留白，框内可用高 = 30 − 7 − 上内边距 5 − 下内边距 2 = 16dp，
         装 16sp 数字（墨迹约 11.5dp）够用——这也是「压缩看得见」的关键：常态绘制框 36−7=29dp、模式态 30−7=23dp，缩了 6dp。 -->
    <dimen name="ki_cut_point_height_compact">30dp</dimen>
    <dimen name="ki_cut_point_text_size">16sp</dimen>

    <!-- 插入/拆分横线：可见线粗 4dp（< 每条线占用的 6dp 槽，才能「居中且不贴框」；等于 6dp 时会正好填满槽、上下都贴住）。
         上下各 @dimen/ki_cut_insert_line_gap(2dp) 是透明留白，把可点区外扩到 8dp（视觉上只有那 4dp 线）。 -->
    <dimen name="ki_cut_insert_line_thickness">4dp</dimen>
    <dimen name="ki_cut_insert_line_gap">2dp</dimen>
    <!-- 中间各条横线下移的基准量：点行框体顶部有 ≈7dp 浮起说明留白（material 的 calculateLabelMarginTop，
         hintEnabled 时恒在、与有没有列名文字无关），故相邻两行的「框体」之间其实是 7dp 留白 + 6dp 槽 = 13dp；
         横线下移约半个留白（本值）才落在两框正中。由 KiCutTableEditor#applyLineMargins 使用。 -->
    <dimen name="ki_cut_insert_line_shift">4dp</dimen>

    <!-- 簇块常态的基准下内边距：＝横线的净占高（36−30 = 6dp）。它不是装饰，是「两种模式与常态严格等高」的
         补偿基数——模式态把本块下内边距按「相对常态多出/缺少的高度」增删（多出减、缺少加，见
         KiCutTableEditor#applyModeVisuals），故常态必须留得住这 6dp 才减得动。 -->
    <dimen name="ki_cut_cluster_pad_bottom">6dp</dimen>
</resources>
