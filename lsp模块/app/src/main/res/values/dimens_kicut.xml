<?xml version="1.0" encoding="utf-8"?>
<!--
    分段倍率表（编辑器）自用尺寸。
    此键族的既有条目都写在 G 包独占的 dimens_config.xml 里，本包不得改那个文件，
    故本包新增的尺寸一律集中在此（既有条目仍只读引用 dimens_config.xml）。
-->
<resources>
    <!-- 点行四个数字框的高与字号：常态 30dp（列名照常浮起）；删除按钮常态也 30dp，行高即 30dp。 -->
    <dimen name="ki_cut_point_height">30dp</dimen>
    <!-- 模式态（插入/拆分）框高：＝常态 30dp − 横线占用高度 6dp，故「框 + 线」合计仍 30dp，整表总高不变。
         此高度配 15sp 数字需同时关掉浮起列名（见 KiCutTableEditor#applyModeVisuals），否则装不下。 -->
    <dimen name="ki_cut_point_height_compact">24dp</dimen>
    <dimen name="ki_cut_point_text_size">15sp</dimen>

    <!-- 插入/拆分横线：可见线粗 6dp；上下各 2dp 透明留白＝命中区外扩（配合负外边距，视觉上仍是零间隙、不吃行高）。 -->
    <dimen name="ki_cut_insert_line_thickness">6dp</dimen>
    <dimen name="ki_cut_insert_line_gap">2dp</dimen>
</resources>
