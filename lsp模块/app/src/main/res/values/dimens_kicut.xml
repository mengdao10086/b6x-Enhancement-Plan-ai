<?xml version="1.0" encoding="utf-8"?>
<!--
    分段倍率表（编辑器）自用尺寸。
    此键族的既有条目都写在 G 包独占的 dimens_config.xml 里，本包不得改那个文件，
    故本包新增的尺寸一律集中在此（既有条目仍只读引用 dimens_config.xml）。
-->
<resources>
    <!-- 点行四个数字框的高与字号：本轮缩到 24dp（原 36dp）；删除按钮仍用 @dimen/ki_cut_del_size(30dp)，
         故整行高度仍由它撑到 30dp。24dp 配 15sp 数字余量很紧，真机是否裁字待验（见交付报告未验证项）。 -->
    <dimen name="ki_cut_point_height">24dp</dimen>
    <dimen name="ki_cut_point_text_size">15sp</dimen>

    <!-- 插入/拆分横线：可见线粗 6dp（原 2dp 的 3 倍）；
         上下各 4dp 透明留白＝触摸外扩（等价「透明扩展」，不用 TouchDelegate，以免把命中区叠到 24dp 的输入框上、误触）。 -->
    <dimen name="ki_cut_insert_line_thickness">6dp</dimen>
    <dimen name="ki_cut_insert_line_gap">4dp</dimen>
</resources>
