<?xml version="1.0" encoding="utf-8"?>
<!--
    分段倍率表（编辑器）新增颜色。
    此键族的既有颜色都在 G 包独占的 colors.xml 里，本包不得改那个文件，
    故本包新增的颜色一律集中在此（既有条目如 ki_cut_up/down/kdp/del 仍只读引用 colors.xml）。
-->
<resources>
    <!-- 插入横线常态色：取「开关用的那种绿」＝主题 colorPrimary＝@color/brand_primary
         （app 的 MaterialSwitch 未自定义 tint，走 Material3 默认即 colorPrimary；
         别名引用使其随明暗主题自动取值：浅色 #00696E / 深色 #7FD5D6）。 -->
    <color name="ki_cut_insert_line">@color/brand_primary</color>
    <!-- 拆分态横线色：不透明红，与常态的绿在色相与明度上都明显区分 -->
    <color name="ki_cut_insert_line_split">#E53935</color>
    <!-- 拆分态覆盖整行的命中层底色（提示「此行可点」） -->
    <color name="ki_cut_row_split_overlay">#33E53935</color>
</resources>
