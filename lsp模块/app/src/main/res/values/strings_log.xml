<?xml version="1.0" encoding="utf-8"?>
<!-- 日志页（D3）专属文案。其他页面不要引用本文件。 -->
<resources>

    <string name="log_section_file">日志文件</string>

    <!-- 来源选择器：选项顺序须与 LogFragment 的 SOURCE_DAEMON / SOURCE_LSPOSED 一致 -->
    <string-array name="log_source_entries">
        <item>daemon</item>
        <item>LSPosed</item>
    </string-array>

    <string name="log_filter_hint">关键词（大小写不敏感）</string>
    <string name="log_loading">正在读取日志…</string>

    <!-- 信息条首行：只有路径（不带标签）；修改时间与统计行同占下一行，见 log_stat_lines_fmt -->
    <string name="log_info_fmt">%1$s</string>
    <string name="log_value_unknown">—</string>

    <!--
        统计行：与修改时间同一行、右对齐。行数与文件大小两段独立，按 log_stat_join_fmt 拼接。
        行数取 Snapshot.candidateLines / lineLimit，文件取 stat 字节数 / byteLimit，k = 1024 字节。
        截断显式写出：行数达上限标「尾部」，文件超 byteLimit 标「仅读尾部」。
    -->
    <string name="log_stat_lines_fmt">显示 %1$d 行（上限 %2$d）</string>
    <string name="log_stat_lines_tail_fmt">显示尾部 %1$d 行（上限 %2$d）</string>
    <string name="log_stat_file_fmt">文件 %1$s k</string>
    <string name="log_stat_file_tail_fmt">文件 %1$s k，仅读尾部 %2$s k</string>
    <string name="log_stat_join_fmt">%1$s· %2$s</string>
    <string name="log_stat_failed">读取失败：未渲染任何行</string>

    <!-- 过滤命中计数：只在有关键词时显示（无关键词时行数在「日志文件」卡的统计行里） -->
    <string name="log_count_hit_fmt">命中 %1$d 行</string>

    <string name="log_empty_no_lines">没有可显示的行（日志内容为空）</string>
    <string name="log_empty_no_b6x">没有 b6x 模块的日志行（仅显示 com.example.waspwingtempctrl 的条目）</string>
    <string name="log_empty_no_hit">没有命中「%1$s」的行（仅在最近 %2$d 行内匹配）</string>

    <string name="log_failure_title">读取失败（下方为原始诊断）</string>
    <string name="log_empty_file_hint">提示：文件存在但为 0 字节 —— c-daemon 还没写过日志，或 LOG_MAX=0 关闭了日志。</string>

    <!-- 单行超长截断提示（阈值见 LogTailReader.MAX_LINE_CHARS），不静默隐藏内容 -->
    <string name="log_line_truncated">…（超长行，仅显示前 %1$d 字符）</string>

    <string name="log_action_follow_bottom">回到底部</string>

    <!-- 整行选择操作条（长按日志行后浮出） -->
    <string name="log_action_copy">复制</string>
    <string name="log_action_cancel">取消</string>

</resources>
