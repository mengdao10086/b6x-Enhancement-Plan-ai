<?xml version="1.0" encoding="utf-8"?>
<!--
    全应用唯一主题。颜色名在 values-night/colors.xml 有同名深色版本，故本文件只有一份。

    注意：AndroidManifest.xml 里没有 android:theme（该文件本轮冻结，不许改），
    因此 SetupActivity 在 super.onCreate() 之前调用 setTheme(R.style.Theme_B6XTempCtrl) 应用本主题。
    子 agent 不要另建主题、不要改本文件。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.B6XTempCtrl" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- 品牌主色 -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
        <item name="colorControlActivated">@color/brand_primary</item>

        <!-- 中性面 -->
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_on_surface</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/app_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/app_surface_container_high</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorOutlineVariant">@color/app_outline_variant</item>

        <!-- 错误色（同时也用于"未生效"等强提示） -->
        <item name="colorError">@color/state_error</item>
        <item name="colorOnError">@color/brand_on_primary</item>
        <item name="colorErrorContainer">@color/state_error_container</item>

        <!-- 窗口 -->
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="android:colorBackgroundFloating">@color/app_surface_container</item>
        <item name="android:windowBackground">@color/app_surface</item>
        <item name="android:statusBarColor">@color/app_surface</item>
        <item name="android:navigationBarColor">@color/app_surface</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <!-- 卡片与控件圆角统一走此处 -->
        <item name="materialCardViewStyle">@style/Widget.B6XTempCtrl.Card</item>
    </style>

    <style name="Widget.B6XTempCtrl.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/app_outline_variant</item>
        <item name="strokeWidth">@dimen/divider_height</item>
        <item name="cardBackgroundColor">@color/app_surface_container</item>
    </style>

    <!-- 卡片内区块标题 -->
    <style name="TextAppearance.B6XTempCtrl.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/app_on_surface</item>
    </style>

    <!-- 次要说明 / 单位 -->
    <style name="TextAppearance.B6XTempCtrl.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/app_on_surface_variant</item>
    </style>

    <!-- 日志与诊断等宽文本 -->
    <style name="TextAppearance.B6XTempCtrl.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">@dimen/text_mono</item>
        <item name="android:textColor">@color/app_on_surface</item>
    </style>

    <!-- "未生效"徽标 -->
    <style name="Widget.B6XTempCtrl.Badge" parent="">
        <item name="android:background">@drawable/bg_badge_muted</item>
        <item name="android:textColor">@color/badge_muted_fg</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:paddingStart">@dimen/badge_padding_h</item>
        <item name="android:paddingEnd">@dimen/badge_padding_h</item>
        <item name="android:paddingTop">@dimen/badge_padding_v</item>
        <item name="android:paddingBottom">@dimen/badge_padding_v</item>
    </style>

</resources>
