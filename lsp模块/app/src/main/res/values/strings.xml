<?xml version="1.0" encoding="utf-8"?>
<!-- 界面外壳（SetupActivity / StatusFragment）的文案。三个界面子 agent 各自维护自己的 strings_*.xml。 -->
<resources>
    <string name="title_setup">飞智温控增强</string>
    <!-- 标题栏右侧设置按钮（点开为「[4] 界面」那组界面参数） -->
    <string name="action_settings">设置</string>

    <string name="tab_status">状态</string>
    <string name="tab_log">日志</string>

    <!-- 状态页 -->
    <string name="status_section_deploy">部署状态</string>
    <string name="status_section_device">设备与版本</string>
    <string name="status_section_actions">操作记录</string>
    <string name="status_loading">读取中…</string>
    <string name="status_action_refresh">刷新状态</string>
    <string name="status_action_deploy">一键部署</string>
    <string name="status_action_uninstall">卸载部署</string>
    <string name="status_action_start">拉起daemon</string>
    <string name="status_action_stop">停止daemon</string>
    <string name="status_action_diag">su 诊断</string>
    <string name="status_busy_other">上一个动作还没结束，请稍候</string>
    <string name="status_dialog_diag">诊断</string>
    <string name="status_dialog_failed">执行失败</string>
    <string name="status_dialog_close">关闭</string>
    <string name="status_busy_probe">读取部署状态…</string>
    <string name="status_busy_deploy">部署中…（落盘 + root 就位 + 省电白名单 + 拉起daemon）</string>
    <string name="status_busy_uninstall">卸载部署中…</string>
    <!-- 拉起＝停旧实例再起新实例，空窗只来自等旧实例退出（最多 8 秒），故把代价写在忙态文案里（手动动作会进「操作记录」） -->
    <string name="status_busy_start">拉起daemon…（停旧实例→起新实例，温控空窗约 10 秒内）</string>
    <string name="status_busy_stop">停止daemon…</string>
    <string name="status_busy_diag">采集 su 诊断…</string>

    <!--
        状态页：破坏性动作的二次确认（与配置页「重置」同一口径：确认才动手，默认不动作）。
        两个动作都会让温控增强失效，故各给一句后果说明；肯定按钮用动作本身的名字，不用泛化的「确定」。
    -->
    <string name="status_dialog_cancel">取消</string>
    <string name="status_dialog_uninstall_title">卸载部署？</string>
    <string name="status_dialog_uninstall_message">将从设备移除 service.d 脚本与守护进程二进制，温控增强失效，需重新「一键部署」才能恢复。是否继续？</string>
    <string name="status_dialog_uninstall_confirm">卸载</string>
    <string name="status_dialog_stop_title">停止daemon？</string>
    <string name="status_dialog_stop_message">将停止正在运行的守护进程，温控增强随之失效，需重新「拉起daemon」才能恢复。是否继续？</string>
    <string name="status_dialog_stop_confirm">停止</string>

    <!-- 状态页：设备与版本（不显示本应用包名与 targetSdk） -->
    <string name="status_info_version">模块版本: %1$s (%2$d)</string>
    <string name="status_info_device">设备: %1$s %2$s</string>
    <string name="status_info_android">Android: %1$s (SDK %2$d)</string>

    <!-- 状态页：首次启动的 root 尝试 -->
    <string name="status_root_ok_log">已获取 root 权限</string>
    <string name="status_root_fail_log">未获取 root 权限（授权被拒或设备未 root），不再自动尝试；点「一键部署」会再试一次</string>
    <string name="status_root_ok_title">已获取 root</string>
    <string name="status_root_ok_message">是否立即一键部署守护进程？</string>
    <string name="status_root_later">稍后</string>

    <!-- 状态页：脚本哈希不一致时的自动重推 -->
    <string name="status_script_autofixed">检测到 service.d 脚本与 APK 内不一致，已自动重推脚本（二进制未动）</string>
    <string name="status_script_autofix_failed">检测到 service.d 脚本与 APK 内不一致，自动重推失败：</string>

    <!--
        状态页：二进制哈希不一致时的部署请求（脚本不一致仍是静默自动重推，不走弹窗）。
        同一个 APK 版本最多弹一次，去重见 StatusFragment.armHashMismatchPrompt。
    -->
    <string name="status_hash_title">守护进程二进制与 APK 不一致</string>
    <string name="status_hash_message">设备上的守护进程二进制与当前 APK 内的不一致，需要重新部署才会生效。是否立即一键部署？\n\n部署会重启守护进程，期间温控短暂空窗（约 10 秒内）。</string>
</resources>
