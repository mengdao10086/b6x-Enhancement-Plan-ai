<?xml version="1.0" encoding="utf-8"?>
<!-- 状态页专用尺寸。共用标尺在 dimens.xml，此处只放本页独有的项。 -->
<resources>

    <!--
        按钮行1 上方的间隔，只服务这一处：「进度条 → 按钮行1」，目标可见空白 5dp。
        该处上下都不挨按钮：上方是文本与进度条，进度条只是一条 4dp 色带、不带 button inset，
        所以本值就是该处的可见空白，可见空白 = 本值（与行间项的口径差异见 status_button_row_gap）。
        取 5dp 而不随行间一起收紧：这是「内容 → 按钮」的过渡，留白比按钮之间略松，
        上方才不至于与进度条粘成一块；行间只有一处（可见 4dp），才是被压紧的节奏。
        沿革：space_m(12dp) → 7dp（3/5）→ 5dp（与第 2 行原引用的 space_s(8dp) 同收 2/3 时一并取整，
        原先分开的两个值合并成本项，space_s 的定义不能动、只换引用点）→ 一度取 2dp → 回到 5dp。
        注意：按钮行1→行2 走 status_button_row_gap，不走本项；
        同一行内相邻按钮之间的 marginStart 仍是 space_s，也不在本项口径内。
    -->
    <dimen name="status_buttons_gap">5dp</dimen>

    <!--
        按钮行1 → 行2 的间隔：保持真机当前观感，目标可见空白 4dp。
        本项是 margin，不是可见空白——两者相差两侧 inset，换算见下。
        行1 里最高的是「一键部署」（垂直 inset 4dp），行2 两个都是 TextButton（垂直 inset 3dp）；
        MaterialButtonHelper.wrapDrawableWithInset() 把背景 drawable 包成 InsetDrawable，
        于是按钮可见的圆角块比它的布局盒上下各小 inset。所以：
            可见空白 = 4dp(行1 insetBottom) + margin(本值) + 3dp(行2 insetTop) = 本值 + 7dp
        取 -3dp：可见空白 = 4 - 3 + 3 = 4dp。
        为什么取负：正数最小取 0 时可见空白仍有 7dp，压不到当前观感；按钮外观不变，
        只能让两行布局盒互相吃掉一点。重叠区落在两侧按钮的内缩空白/文字按钮的空白内边距里，
        不压文字、不改按钮尺寸；下按钮是 TextButton（无可见底色），不会被上按钮圆角块盖住文字。
    -->
    <dimen name="status_button_row_gap">-3dp</dimen>

    <!--
        按钮统一尺寸（「一键部署」单独恢复 M3 默认尺寸，见 status_deploy_button_*）。
        M3 默认：insetTop/Bottom = 4dp、minHeight = 48dp、实心/描边按钮左右内边距 = 24dp。
        本组：insetTop/Bottom = 3dp、minHeight = 46dp → 可见圆角块高 40dp、触控高 46dp；
        水平 inset 2dp（只收背景圆角块，不改布局宽）。
        水平内边距：窄屏（默认，覆盖 360dp）取 13dp；宽屏（≥400dp）取 16dp，见 values-sw400dp。
    -->
    <dimen name="status_button_inset_horizontal">2dp</dimen>
    <dimen name="status_button_inset_vertical">3dp</dimen>
    <dimen name="status_button_padding_horizontal">13dp</dimen>
    <dimen name="status_button_min_height">46dp</dimen>

    <!--
        「一键部署」恢复「自动更新开关迁入状态区首行之前」的 M3 默认尺寸：
        minHeight 48dp、水平内边距 24dp（m3_btn_padding_left/right）、垂直 inset 4dp（m3_btn_inset）、
        水平 inset 0dp。可见圆角块高 = 48 − 4 × 2 = 40dp，与其余按钮一致；触控高回到 48dp。
        宽屏不另设覆盖：收窄前也没有 sw400dp 覆盖项，这里保持同一口径。
    -->
    <dimen name="status_deploy_button_inset_horizontal">0dp</dimen>
    <dimen name="status_deploy_button_inset_vertical">4dp</dimen>
    <dimen name="status_deploy_button_padding_horizontal">24dp</dimen>
    <dimen name="status_deploy_button_min_height">48dp</dimen>

    <!--
        进度条与上方「部署状态」文本之间的间隔，目标可见空白 0dp。
        进度条是 LinearProgressIndicator，不带 MaterialButton 那套 inset，
        故 margin 本身就是可见空白，可见空白 = 本值 = 0dp（此处不加减 8dp，别与 status_button_row_gap 串口径）。
        取 0dp：本页唯一能把可见留白压到 0 的间隔——不挨按钮就没有 inset 可抵，margin 归零即所见为空；
        再往下就是负值，那才是真的让两个布局盒重叠，而这里没有任何内缩区可以承接重叠。
        沿革：原为共用标尺 space_s(8dp) → 5dp（收 2/3）→ 3dp（再收 2/3）→ 0dp。
        新开专用项而非改 space_s，因为后者被多页共用。
    -->
    <dimen name="status_progress_gap">0dp</dimen>
    <!--
        原 diag_body_max_height(200dp) 已删：它只服务"操作记录限高 + 内部滚动"，
        该方案本轮已按用户裁定改为与配置·曲线页诊断卡同款（自适应高、无内部滚动），
        唯一引用点随之消失。若将来再要"自适应但有上限"，须重开一项——
        ScrollView 不支持 android:maxHeight，届时还需配合代码里按内容高度设 LayoutParams。
    -->
</resources>
