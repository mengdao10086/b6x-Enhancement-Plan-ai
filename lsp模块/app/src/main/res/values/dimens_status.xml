<?xml version="1.0" encoding="utf-8"?>
<!-- 状态页专用尺寸。共用标尺在 dimens.xml，此处只放本页独有的项。 -->
<resources>

    <!--
        部署状态文本与按钮行之间的间隔。原为 space_m(12dp)，按要求收到 3/5 ≈ 7dp；
        相邻按钮之间与按钮行之间的间距不动（那不是"与文本的间隔"）。
    -->
    <dimen name="status_buttons_gap">7dp</dimen>

    <!--
        排障正文区的高度上限，状态页「操作记录」与配置页诊断正文区共用同一口径
        （两边封同一个值，"和配置页一样高"才有共同依据；配置页尚未跟进，跟进时引用本项即可）。
        取值 200dp：等宽小字 text_mono 12sp 行高约 16dp，即一屏内约 12 行，
        够看一小段记录又不会把页面顶成一条长卷。
        状态页以"滚动区固定此高"落地：滚动区自身就是上限，内容不足时也不缩短，
        免得展开与刷新时高度反复变。
    -->
    <dimen name="diag_body_max_height">200dp</dimen>
</resources>
