<?xml version="1.0" encoding="utf-8"?>
<!-- 状态页专用尺寸。共用标尺在 dimens.xml，此处只放本页独有的项。 -->
<resources>

    <!--
        按钮行的上方间隔，两行共用同一个值：
          「部署状态文本 → 按钮行1」与「按钮行1 → 按钮行2」，故两处高度节奏一致。
        沿革：原为 space_m(12dp) → 7dp（3/5）；本轮按要求再收到 2/3，7dp/8dp 双双取整为 5dp，
        于是原来分开的两个值合并成一个（第 2 行原引用共用标尺 space_s，故不能改其定义，只换引用点）。
        注意：同一行内相邻按钮之间的 marginStart 仍是 space_s，不在本项口径内。
    -->
    <dimen name="status_buttons_gap">5dp</dimen>

    <!--
        进度条与上方「部署状态」文本之间的间隔。原为共用标尺 space_s(8dp)，本轮按要求收到 2/3 = 5dp；
        新开专用项而非改 space_s，因为后者被多页共用。
    -->
    <dimen name="status_progress_gap">5dp</dimen>
    <!--
        原 diag_body_max_height(200dp) 已删：它只服务"操作记录限高 + 内部滚动"，
        该方案本轮已按用户裁定改为与配置·曲线页诊断卡同款（自适应高、无内部滚动），
        唯一引用点随之消失。若将来再要"自适应但有上限"，须重开一项——
        ScrollView 不支持 android:maxHeight，届时还需配合代码里按内容高度设 LayoutParams。
    -->
</resources>
