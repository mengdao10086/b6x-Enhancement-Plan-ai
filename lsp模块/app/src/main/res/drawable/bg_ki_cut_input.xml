<?xml version="1.0" encoding="utf-8"?>
<!-- KI 分段削减表：点行里三个紧凑数字输入框的底。刻意不复用 item_config_field 的 Material OutlinedBox——
     一张表里格子数量多（簇 × 点 × 3），再用 36dp 高的浮起说明框会撑得极高；这里只保留"描边 + 圆角"这一层观感，
     颜色一律走主题名（app_surface / app_outline），不写死色值。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/app_surface" />
    <stroke
        android:width="@dimen/ki_cut_input_stroke"
        android:color="@color/app_outline" />
    <corners android:radius="@dimen/field_radius" />
</shape>
