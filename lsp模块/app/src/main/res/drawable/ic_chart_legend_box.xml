<?xml version="1.0" encoding="utf-8"?>
<!--
    图例勾选框的两态拼装：按 state_checked 切到 ic_chart_legend_box_on / _off。
    子图固有尺寸 18dp 只是画稿基准；实际显示尺寸由 ChartFragment 在运行时包成
    16dp × k 的 ScaledDrawable（k=1 时 16dp，窄屏按统一比例缩小），
    CompoundButton 的最小高随之变化（见 item_chart_legend.xml 的说明）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_chart_legend_box_on"
        android:state_checked="true" />
    <item android:drawable="@drawable/ic_chart_legend_box_off" />
</selector>
