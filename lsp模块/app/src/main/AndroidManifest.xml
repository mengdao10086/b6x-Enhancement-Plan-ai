<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="飞智温控增强"
        android:icon="@android:drawable/ic_menu_compass"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- ========== Xposed / LSPosed 模块元数据 ========== -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="53" />
        <meta-data
            android:name="xposeddescription"
            android:value="修复B6X/B7X超频软件在安卓16的蓝牙问题，并内置智能温控：原生界面调参、一键部署守护进程" />

        <!-- LSPosed 推荐作用域：管理器 > 模块 > 推荐勾选的应用 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 最小启动壳：显示构建信息与 root 状态；界面本体属线 D -->
        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页：原「[4] 界面」那组界面参数（含「返回退出自动隐藏后台」）的落点，
             入口是 SetupActivity 标题栏右侧的设置按钮，故不导出 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

    </application>

    <!--
        本批次不新增任何权限：
        - SetupActivity 只读构建信息、执行 su，二者都不需要权限
        - RootShell 走 Runtime.exec，不需要权限
        后续批次按需再加（如通知、前台服务），加之前先确认用途。
    -->

</manifest>
