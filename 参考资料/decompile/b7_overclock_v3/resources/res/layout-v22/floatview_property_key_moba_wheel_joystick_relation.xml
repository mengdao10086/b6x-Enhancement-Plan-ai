<?xml version="1.0" encoding="utf-8"?>
<com.flydigi.float_view.widget.PropertyLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/qb_px_24"
    android:paddingTop="@dimen/qb_px_8"
    android:paddingRight="@dimen/qb_px_24"
    android:paddingBottom="@dimen/qb_px_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/floatview_shape_divider"
    android:showDividers="middle"
    android:paddingHorizontal="@dimen/qb_px_24"
    android:paddingVertical="@dimen/qb_px_8">
    <com.flydigi.float_view.widget.FloatViewSingleSeekBarView
        android:id="@+id/ssb_radius_wheel"
        android:layout_width="@dimen/qb_px_320"
        android:layout_height="wrap_content"
        app:floatview_ssb_hint_max="@string/floatview_larger"
        app:floatview_ssb_hint_min="@string/floatview_smaller"
        app:floatview_ssb_name="@string/floatview_radius_wheel"
        app:floatview_ssb_show_hint="true"
        app:floatview_ssb_value_default="50"
        app:floatview_ssb_value_max="127"/>
    <com.flydigi.float_view.widget.FloatViewSingleSeekBarView
        android:id="@+id/ssb_radius_wheel_ban"
        android:layout_width="@dimen/qb_px_320"
        android:layout_height="wrap_content"
        app:floatview_ssb_hint_max="@string/floatview_larger"
        app:floatview_ssb_hint_min="@string/floatview_smaller"
        app:floatview_ssb_name="@string/floatview_radius_prevention"
        app:floatview_ssb_show_hint="true"
        app:floatview_ssb_show_name_help="true"
        app:floatview_ssb_value_default="30"
        app:floatview_ssb_value_max="127"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="@dimen/qb_px_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_ffffff_a90"
                android:gravity="center"
                android:id="@+id/tv_change_radius"
                android:paddingTop="@dimen/qb_px_4"
                android:paddingBottom="@dimen/qb_px_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/floatview_property_change_radius"
                android:paddingVertical="@dimen/qb_px_4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_change_radius_help"
                android:background="@drawable/bg_black_20"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/float_ic_floatingsetting_icon_question"
                android:scaleType="fitCenter"
                android:layout_marginStart="@dimen/qb_px_8"
                app:layout_constraintBottom_toBottomOf="@+id/tv_change_radius"
                app:layout_constraintDimensionRatio="w,1:1"
                app:layout_constraintStart_toEndOf="@+id/tv_change_radius"
                app:layout_constraintTop_toTopOf="@+id/tv_change_radius"/>
            <com.flydigi.float_view.widget.FloatViewKeySetView
                android:id="@+id/ksv_change_radius"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/qb_px_32"
                app:floatview_ksv_title="@string/floatview_change_radius_key"
                app:layout_constraintBottom_toBottomOf="@+id/tv_change_radius"
                app:layout_constraintStart_toEndOf="@+id/iv_change_radius_help"
                app:layout_constraintTop_toTopOf="@+id/tv_change_radius"/>
            <com.flydigi.float_view.widget.FloatViewSingleSeekBarView
                android:id="@+id/ssb_radius_after_change"
                android:layout_width="@dimen/qb_px_320"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_4"
                app:floatview_ssb_hint_max="@string/floatview_larger"
                app:floatview_ssb_hint_min="@string/floatview_smaller"
                app:floatview_ssb_name="@string/floatview_radius_changed"
                app:floatview_ssb_show_hint="true"
                app:floatview_ssb_show_unit="true"
                app:floatview_ssb_unit_inside="true"
                app:floatview_ssb_unit_name="%"
                app:floatview_ssb_value_default="10"
                app:floatview_ssb_value_max="100"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_change_radius"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.flydigi.float_view.widget.FloatViewSingleCheckBoxView
            android:id="@+id/scb_reverse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:floatview_scb_checkbox_name="@string/floatview_reverse"/>
    </LinearLayout>
    <com.flydigi.float_view.widget.FloatViewPropertyIntroductionView
        android:id="@+id/introduction_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:floatview_piv_desc="@string/floatview_property_key_moba_lunpan_relation_desc"/>
</com.flydigi.float_view.widget.PropertyLinearLayout>
