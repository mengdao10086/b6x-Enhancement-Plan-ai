<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/magic_indicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/stub_customer_service_tip"
        android:layout="@layout/app_view_customer_service_tip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_36"
        android:layout_marginLeft="@dimen/qb_px_16"
        android:layout_marginRight="@dimen/qb_px_16"
        android:layout_marginBottom="@dimen/qb_px_4"
        android:layout_above="@+id/tv_device_manager"
        android:layout_marginHorizontal="@dimen/qb_px_16"
        app:layout_constraintBottom_toTopOf="@+id/magic_indicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <net.lucode.hackware.magicindicator.MagicIndicator
        android:id="@+id/magic_indicator"
        android:background="@color/white"
        android:paddingBottom="@dimen/qb_px_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_44"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/main_home_tab_text_selector"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/tv_device_manager"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_2"
        android:text="@string/device_manager"
        android:drawablePadding="@dimen/qb_px_4"
        app:drawableTopCompat="@drawable/app_selector_home_bottom_icon_device_manager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
