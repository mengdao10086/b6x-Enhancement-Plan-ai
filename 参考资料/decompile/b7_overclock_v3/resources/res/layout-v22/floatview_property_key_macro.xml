<?xml version="1.0" encoding="utf-8"?>
<com.flydigi.float_view.widget.PropertyLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingLeft="@dimen/qb_px_24"
    android:paddingTop="@dimen/qb_px_10"
    android:paddingRight="@dimen/qb_px_24"
    android:paddingBottom="@dimen/qb_px_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/qb_px_24"
    android:paddingVertical="@dimen/qb_px_10">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_ffffff_a90"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/floatview_macro_key"/>
        <TextView
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_ffffff_a90"
            android:gravity="center"
            android:id="@+id/tv_macro_number"
            android:background="@drawable/bg_gray_5"
            android:layout_width="@dimen/qb_px_56"
            android:layout_height="@dimen/qb_px_24"
            android:layout_marginStart="@dimen/qb_px_8"/>
        <Button
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_ffffff_a90"
            android:gravity="center"
            android:id="@+id/btn_edit"
            android:background="@color/colorPrimary"
            android:layout_width="@dimen/qb_px_72"
            android:layout_height="@dimen/qb_px_24"
            android:text="@string/floatview_macro_edit"
            android:layout_marginStart="@dimen/qb_px_16"/>
        <Button
            android:textSize="@dimen/sp_10"
            android:textColor="@color/color_ffffff_a90"
            android:gravity="center"
            android:id="@+id/btn_import"
            android:background="@color/colorPrimary"
            android:layout_width="@dimen/qb_px_72"
            android:layout_height="@dimen/qb_px_24"
            android:text="@string/floatview_macro_import"
            android:layout_marginStart="@dimen/qb_px_8"/>
    </LinearLayout>
    <com.flydigi.float_view.widget.FloatViewKeySetView
        android:id="@+id/ksv_key_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:floatview_ksv_title="@string/floatview_macro_cancel_key"/>
    <com.flydigi.float_view.widget.FloatViewPropertyIntroductionView
        android:id="@+id/introduction_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:floatview_piv_desc="@string/floatview_property_key_macro_desc"/>
</com.flydigi.float_view.widget.PropertyLinearLayout>
