<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_device"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/qb_px_64"
        android:layout_marginTop="@dimen/qb_px_16"
        android:layout_marginRight="@dimen/qb_px_64"
        android:layout_marginBottom="@dimen/qb_px_8"
        android:scaleType="centerInside"
        android:layout_marginHorizontal="@dimen/qb_px_64"
        app:layout_constraintDimensionRatio="w,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/color_000000_a90"
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/qb_px_32"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginRight="@dimen/qb_px_32"
        android:layout_marginHorizontal="@dimen/qb_px_32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_device"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorAccentGreen"
        android:id="@+id/tv_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        app:layout_constraintStart_toStartOf="@+id/tv_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_000000_a50"
        android:id="@+id/tv_temperature_b3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/qb_px_8"
        app:layout_constraintStart_toEndOf="@+id/tv_state"
        app:layout_constraintTop_toTopOf="@+id/tv_state"/>
</androidx.constraintlayout.widget.ConstraintLayout>
