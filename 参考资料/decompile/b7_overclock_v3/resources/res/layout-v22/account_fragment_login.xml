<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorWindowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="@dimen/qb_px_16"
        android:paddingTop="@dimen/qb_px_20"
        android:paddingRight="@dimen/qb_px_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/qb_px_16">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/area_account"
            android:background="@color/color_000000_a04"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_44"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <EditText
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_000000_a90"
                android:textColorHint="@color/color_000000_a30"
                android:id="@+id/et_account"
                android:background="@color/transparent"
                android:paddingLeft="@dimen/qb_px_12"
                android:paddingRight="@dimen/qb_px_12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/account_phone_email"
                android:singleLine="true"
                android:drawablePadding="@dimen/qb_px_8"
                android:layout_weight="1"
                android:drawableStart="@drawable/account_ic_phone_gray"
                android:paddingHorizontal="@dimen/qb_px_12"/>
            <top.androidman.SuperButton
                android:id="@+id/iv_clear_account"
                android:visibility="gone"
                android:layout_width="@dimen/qb_px_44"
                android:layout_height="@dimen/qb_px_44"
                app:background_normalColor="@color/transparent"
                app:icon="@drawable/account_ic_delete"
                app:iconColor="@color/color_000000_a50"
                app:iconHeight="@dimen/qb_px_16"
                app:iconWidth="@dimen/qb_px_16"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/area_password"
            android:background="@color/color_000000_a04"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_44"
            android:layout_marginTop="@dimen/qb_px_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/area_verify_code"
            app:passwordToggleEnabled="true">
            <EditText
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_000000_a90"
                android:textColorHint="@color/color_000000_a30"
                android:id="@+id/et_password"
                android:background="@color/transparent"
                android:paddingLeft="@dimen/qb_px_12"
                android:paddingRight="@dimen/qb_px_12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/account_label_password"
                android:singleLine="true"
                android:drawablePadding="@dimen/qb_px_8"
                android:layout_weight="1"
                android:inputType="textPassword"
                android:drawableStart="@drawable/account_ic_password_gray"
                android:paddingHorizontal="@dimen/qb_px_12"
                android:autofillHints="password"/>
            <top.androidman.SuperButton
                android:id="@+id/iv_clear_password"
                android:visibility="gone"
                android:layout_width="@dimen/qb_px_44"
                android:layout_height="@dimen/qb_px_44"
                android:scaleType="centerInside"
                app:background_normalColor="@color/transparent"
                app:icon="@drawable/account_ic_delete"
                app:iconColor="@color/color_000000_a50"
                app:iconHeight="@dimen/qb_px_16"
                app:iconWidth="@dimen/qb_px_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_show_password"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_show_password"
                android:layout_width="@dimen/qb_px_44"
                android:layout_height="@dimen/qb_px_44"
                android:src="@drawable/account_ic_password_visible"
                android:scaleType="centerInside"
                android:alpha="0.5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <Button
            android:enabled="false"
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_white"
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_48"
            android:layout_marginTop="@dimen/qb_px_32"
            android:text="@string/account_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/area_password"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_12">
            <Button
                android:textSize="@dimen/sp_15"
                android:textColor="@color/colorTextPrimary"
                android:id="@+id/tv_forget_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_action_forget_password"
                android:textAllCaps="false"
                app:layout_constraintEnd_toStartOf="@+id/tv_register"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
            <Button
                android:textSize="@dimen/sp_15"
                android:textColor="@color/colorTextPrimary"
                android:id="@+id/tv_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_register"
                android:textAllCaps="false"
                android:layout_alignParentEnd="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_forget_password"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_40">
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_black_33"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_please_select_other_way"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_12">
                <ImageButton
                    android:id="@+id/iv_qq"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/qb_px_56"
                    android:layout_height="@dimen/qb_px_56"
                    android:src="@drawable/account_qq_login_bg"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/qq"
                    app:layout_constraintEnd_toStartOf="@+id/iv_weixin"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
                <ImageButton
                    android:id="@+id/iv_weixin"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/qb_px_56"
                    android:layout_height="@dimen/qb_px_56"
                    android:src="@drawable/account_weixin_login_bg"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/weixin"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_qq"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_user_agreement"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/qb_px_20"
                android:layout_marginBottom="@dimen/qb_px_20"
                android:layout_marginVertical="@dimen/qb_px_20">
                <CheckBox
                    android:id="@+id/cb_user_policy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/sp_13"
                    android:textColor="@color/colorTextPrimary"
                    android:id="@+id/tv_user_policy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
