<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/shape_bg_bottom_dialog"
        android:layout_width="@dimen/qb_px_340"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/qb_px_10">
        <ImageView
            android:id="@+id/btn_close"
            android:padding="@dimen/qb_px_8"
            android:layout_width="@dimen/qb_px_32"
            android:layout_height="@dimen/qb_px_32"
            android:layout_marginTop="@dimen/qb_px_8"
            android:src="@drawable/ic_close"
            android:alpha="0.3"
            android:layout_marginEnd="@dimen/qb_px_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_000000_a90"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_8"
            android:layout_marginStart="@dimen/qb_px_16"
            android:layout_marginEnd="@dimen/qb_px_16"
            app:layout_constraintBottom_toTopOf="@+id/btn_help"
            app:layout_constraintTop_toBottomOf="@+id/btn_close">
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_000000_a50"
                android:id="@+id/tv_notice"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/qb_px_16"/>
            <TextView
                android:textSize="@dimen/sp_13"
                android:textColor="#df1414"
                android:id="@+id/tv_alert"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/qb_px_16"/>
            <Space
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qb_px_16"/>
            <com.flydigi.device_manager.view.MappingModeView
                android:id="@+id/rb_mode_flashplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:desc="@string/device_mapping_mode_flashplay_desc_whole"
                app:title="@string/device_mapping_mode_flashplay"/>
            <Space
                android:layout_width="wrap_content"
                android:layout_height="@dimen/qb_px_16"/>
            <com.flydigi.device_manager.view.MappingModeView
                android:id="@+id/rb_mode_tradition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:desc="@string/device_mapping_mode_tradition_desc_whole"
                app:title="@string/device_traditional_mapping_mode"/>
            <Button
                android:enabled="false"
                android:textSize="@dimen/sp_14"
                android:textColor="@color/white"
                android:id="@+id/btn_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_16"
                android:text="@string/confirm"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
        <Button
            android:textSize="@dimen/sp_13"
            android:textColor="@color/colorPrimary"
            android:id="@+id/btn_help"
            android:paddingLeft="@dimen/qb_px_16"
            android:paddingTop="@dimen/qb_px_8"
            android:paddingRight="@dimen/qb_px_16"
            android:paddingBottom="@dimen/qb_px_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_8"
            android:text="@string/device_how_to_choose"
            android:paddingHorizontal="@dimen/qb_px_16"
            android:paddingVertical="@dimen/qb_px_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
