<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_parent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_44">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_gray_96"
            android:gravity="center"
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1"/>
        <View
            android:background="@color/base_color_divider"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginLeft="@dimen/qb_px_20"
            android:layout_marginRight="@dimen/qb_px_20"
            android:layout_marginHorizontal="@dimen/qb_px_20"/>
    </LinearLayout>
</RelativeLayout>
