<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="#140074ff"
        android:paddingTop="@dimen/qb_px_8"
        android:paddingBottom="@dimen/qb_px_8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_36"
        android:paddingStart="@dimen/qb_px_16"
        android:paddingEnd="@dimen/qb_px_16">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorPrimary"
            android:id="@+id/tv_hint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/device_check_developer_permission_reason"
            android:layout_weight="1"/>
        <top.androidman.SuperButton
            android:id="@+id/btn_help"
            android:layout_width="@dimen/qb_px_36"
            android:layout_height="@dimen/qb_px_36"
            android:contentDescription="@string/device_help"
            app:background_normalColor="@color/transparent"
            app:icon="@drawable/ic_custom_service"
            app:iconColor="@color/colorPrimary"
            app:iconHeight="@dimen/qb_px_20"
            app:iconWidth="@dimen/qb_px_20"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <WebView
            android:id="@+id/view_web"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/progress_bar"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/pb_loading"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateDrawable="@drawable/data_ic_loading_rotation"
                android:indeterminateDuration="1000"
                android:indeterminateBehavior="repeat"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/colorTextTertiary"
                android:id="@+id/tv_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/loading"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/area_message"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_message"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="80dp"
                android:src="@drawable/data_ic_net_error"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/colorTextTertiary"
                android:id="@+id/tv_error_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/net_state_error"/>
            <TextView
                android:textColor="@color/colorTextTertiary"
                android:gravity="center"
                android:background="@drawable/bg_round_gray_stroke"
                android:layout_width="95dp"
                android:layout_height="28dp"
                android:layout_marginTop="16dp"
                android:text="@string/load_again"/>
        </LinearLayout>
    </FrameLayout>
    <Button
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_ffffff_a90"
        android:gravity="center"
        android:id="@+id/btn_open_permission"
        android:background="@drawable/selector_bg_action_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/qb_px_16"
        android:layout_marginTop="@dimen/qb_px_8"
        android:layout_marginRight="@dimen/qb_px_16"
        android:layout_marginBottom="@dimen/qb_px_8"
        android:text="@string/device_setting_now"
        android:layout_marginHorizontal="@dimen/qb_px_16"
        android:layout_marginVertical="@dimen/qb_px_8"/>
</LinearLayout>
