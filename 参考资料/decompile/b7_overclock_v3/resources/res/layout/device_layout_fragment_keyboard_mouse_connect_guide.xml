<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextTitle"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/device_connect_keyboard_and_mouse"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/area_step_1"
        android:background="@drawable/device_connection_usb_bg"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <ImageView
            android:id="@+id/iv_step_1"
            android:background="@drawable/device_shape_round_rect"
            android:padding="1dp"
            android:layout_width="103dp"
            android:layout_height="103dp"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorTextPrimary"
            android:id="@+id/tv_step_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/area_step_2"
        android:background="@drawable/device_connection_usb_bg"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/area_step_1">
        <ImageView
            android:id="@+id/iv_step_2"
            android:background="@drawable/device_shape_round_rect"
            android:padding="1dp"
            android:layout_width="103dp"
            android:layout_height="103dp"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorTextPrimary"
            android:id="@+id/tv_step_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/area_step_3"
        android:background="@drawable/device_connection_usb_bg"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/area_step_2">
        <ImageView
            android:id="@+id/iv_step_3"
            android:background="@drawable/device_shape_round_rect"
            android:padding="1dp"
            android:layout_width="103dp"
            android:layout_height="103dp"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorTextPrimary"
            android:id="@+id/tv_step_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="32dp"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/colorTextTertiary"
        android:id="@+id/tv_usb1_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/area_step_3"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/colorTextTertiary"
        android:id="@+id/tv_usb2_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toEndOf="@+id/tv_usb1_state"
        app:layout_constraintTop_toTopOf="@+id/tv_usb1_state"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorTextTertiary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/btn_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="18dp"
        android:text="@string/device_connection_ask_for_help"
        android:drawableEnd="@drawable/device_ic_double_arrow_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
