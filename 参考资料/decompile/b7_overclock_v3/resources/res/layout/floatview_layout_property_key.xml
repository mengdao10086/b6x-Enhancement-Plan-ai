<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_000000_a40"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_top"
        android:background="@color/color_101010"
        android:layout_width="0dp"
        android:layout_height="@dimen/qb_px_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/area_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/qb_px_20">
            <com.flydigi.float_view.widget.ExpandView
                android:id="@+id/iv_key"
                android:layout_width="@dimen/qb_px_22"
                android:layout_height="@dimen/qb_px_22"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_ffffff_a90"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/qb_px_10"
            android:text="@string/floatview_property_key_title"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/area_key"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/key_display_state"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/qb_px_20"
            android:layout_toRightOf="@+id/tv_title">
            <ImageView
                android:id="@+id/key_display_state_image"
                android:layout_width="@dimen/qb_px_24"
                android:layout_height="@dimen/qb_px_24"
                android:src="@drawable/floatingsetting_display"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_ffffff_a90"
                android:id="@+id/key_display_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/floatview_show"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="@dimen/qb_px_264"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/lib_color_10"
                android:gravity="center"
                android:id="@+id/tv_copy_key_property"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/floatview_copy_key_property"
                android:layout_weight="1"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/lib_color_10"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/lib_color_10"
                android:layout_width="1dp"
                android:layout_height="@dimen/qb_px_14"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:id="@+id/tv_ok"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/listview_1"
        android:background="@color/lib_color_12"
        android:layout_width="@dimen/qb_px_120"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_top"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/listview_2"
        android:background="@color/lib_color_13"
        android:layout_width="@dimen/qb_px_120"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/listview_1"
        app:layout_constraintTop_toBottomOf="@+id/rl_top"/>
    <ScrollView
        android:background="#232323"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/listview_2"
        app:layout_constraintTop_toBottomOf="@+id/rl_top">
        <FrameLayout
            android:id="@+id/area_property_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <include
        android:id="@+id/layout_question"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_0"
        android:layout_height="@dimen/qb_px_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/floatview_widget_help_dialog"/>
    <include
        android:id="@+id/layout_wait_click"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_0"
        android:layout_height="@dimen/qb_px_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/floatview_widget_key_listen"/>
</androidx.constraintlayout.widget.ConstraintLayout>
