<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="?android:attr/actionBarSize"
                android:layout_height="?android:attr/actionBarSize"
                android:src="@drawable/ic_left"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <EditText
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/colorTextTitle"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/et_search"
                    android:background="@drawable/main_bg_search"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_30"
                    android:hint="@string/game_search_hint"
                    android:maxEms="30"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:paddingEnd="@dimen/qb_px_36">
                    <requestFocus/>
                </EditText>
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/btn_clear"
                    android:visibility="invisible"
                    android:layout_width="@dimen/qb_px_24"
                    android:layout_height="@dimen/qb_px_24"
                    android:src="@drawable/main_ic_circle_close"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="@dimen/qb_px_16"/>
            </FrameLayout>
            <Button
                android:textSize="@dimen/sp_14"
                android:textColor="@color/colorTextPrimary"
                android:id="@+id/btn_search"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/search"
                style="@style/Widget.AppCompat.Button.Borderless"/>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.flydigi.game.widget.SearchRecoView
            android:id="@+id/search_reco_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</LinearLayout>
