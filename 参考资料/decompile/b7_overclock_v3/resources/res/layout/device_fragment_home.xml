<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_28"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/device_manager"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/qb_px_16"
            android:layout_marginEnd="@dimen/qb_px_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_000000_a90"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_radiator"
            android:padding="@dimen/qb_px_10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_name_radiator"
            android:drawablePadding="@dimen/qb_px_4"
            app:drawableTopCompat="@drawable/device_ic_radiator"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toStartOf="@+id/btn_headset"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_000000_a90"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_headset"
            android:padding="@dimen/qb_px_10"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_headset"
            android:drawablePadding="@dimen/qb_px_4"
            app:drawableTopCompat="@drawable/ic_fox"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toStartOf="@+id/btn_add"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_000000_a90"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_add"
            android:padding="@dimen/qb_px_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/floatview_add"
            android:drawablePadding="@dimen/qb_px_4"
            app:drawableTopCompat="@drawable/ic_add"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toStartOf="@+id/btn_help"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_000000_a90"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/btn_help"
            android:padding="@dimen/qb_px_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_help"
            android:drawablePadding="@dimen/qb_px_4"
            app:drawableTopCompat="@drawable/ic_custom_service"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/area_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include
                    android:id="@+id/area_notice"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qb_px_88"
                    android:layout_marginLeft="@dimen/qb_px_16"
                    android:layout_marginTop="@dimen/qb_px_16"
                    android:layout_marginRight="@dimen/qb_px_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/device_item_my_game_zone_header_notice"/>
                <FrameLayout
                    android:id="@+id/container_my_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/qb_px_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/area_notice"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_action"
                android:background="@drawable/shape_bg_action_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_48"
                android:layout_marginLeft="@dimen/qb_px_32"
                android:layout_marginTop="@dimen/qb_px_32"
                android:layout_marginRight="@dimen/qb_px_32"
                android:layout_marginBottom="@dimen/qb_px_64"
                android:text="@string/device_add_first_device"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <FrameLayout
                android:id="@+id/container_game_zone"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/container_my_device"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
