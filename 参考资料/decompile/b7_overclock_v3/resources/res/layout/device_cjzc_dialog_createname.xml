<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/background_1"
        android:background="@drawable/bg_white_10"
        android:layout_width="317dp"
        android:layout_height="160dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_black_33"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="配置名称"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/black_141414"
            android:gravity="center_vertical"
            android:id="@+id/edit_content"
            android:background="@drawable/bg_gray_4"
            android:paddingLeft="10dp"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="15dp"
            android:hint="输入配置名称（2-10个字符）"
            android:maxLength="10"/>
        <View
            android:background="@color/color_gray_ccccd2"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="18dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorTextTertiary"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:text="取消"
                android:layout_weight="1"/>
            <View
                android:background="@color/color_gray_ccccd2"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:text="确定"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/background_2"
        android:background="@drawable/bg_white_10"
        android:visibility="gone"
        android:layout_width="250dp"
        android:layout_height="160dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_black_33"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="是否覆盖"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="28dp"
            android:layout_marginRight="15dp"
            android:text="本地配置列表中已存在当前名称配置，是否覆盖？"/>
        <View
            android:background="@color/color_gray_ccccd2"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="18dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorTextTertiary"
                android:gravity="center"
                android:id="@+id/tv_cancel_2"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:text="取消"
                android:layout_weight="1"/>
            <View
                android:background="@color/color_gray_ccccd2"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:id="@+id/tv_confirm_2"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:text="确定"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
