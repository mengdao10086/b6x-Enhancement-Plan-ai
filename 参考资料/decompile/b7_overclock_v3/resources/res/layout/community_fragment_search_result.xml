<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/area_filter"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:baselineAligned="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="start|center_vertical"
            android:orientation="vertical"
            android:id="@+id/btn_type_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/community_selector_search_type_text"
                android:gravity="center_vertical"
                android:id="@+id/tv_type_all"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/community_all"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tv_type_all_indicator"
                android:background="@color/colorPrimary"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="2dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_type_all"
                app:layout_constraintStart_toStartOf="@+id/tv_type_all"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_all"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="start|center_vertical"
            android:orientation="vertical"
            android:id="@+id/btn_type_raider"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/community_selector_search_type_text"
                android:gravity="center_vertical"
                android:id="@+id/tv_type_raider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/community_raider"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tv_type_raider_indicator"
                android:background="@color/colorPrimary"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="2dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_type_raider"
                app:layout_constraintStart_toStartOf="@+id/tv_type_raider"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_raider"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="start|center_vertical"
            android:orientation="vertical"
            android:id="@+id/btn_type_config"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/community_selector_search_type_text"
                android:gravity="center_vertical"
                android:id="@+id/tv_type_config"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/community_config"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/tv_type_config_indicator"
                android:background="@color/colorPrimary"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="2dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_type_config"
                app:layout_constraintStart_toStartOf="@+id/tv_type_config"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_config"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:id="@+id/btn_handle_category"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="16dp">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/colorPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tv_handle_category"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/community_all"
                android:drawablePadding="1dp"
                android:drawableEnd="@drawable/community_ic_filter"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:background="@color/color_gray_F1"
            android:paddingTop="20dp"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </FrameLayout>
</LinearLayout>
