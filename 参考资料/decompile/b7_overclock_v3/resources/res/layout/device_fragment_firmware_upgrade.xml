<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_upgrade_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_80"
        android:src="@drawable/device_firmware_upgrade_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/color_000000_a90"
        android:id="@+id/tv_upgrade_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_80"
        android:text="0%"
        app:layout_constraintEnd_toEndOf="@+id/iv_upgrade_progress"
        app:layout_constraintStart_toStartOf="@+id/iv_upgrade_progress"
        app:layout_constraintTop_toBottomOf="@+id/iv_upgrade_progress"/>
    <ProgressBar
        android:id="@+id/pb_upgrade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_16"
        android:layout_marginStart="@dimen/qb_px_50"
        android:layout_marginEnd="@dimen/qb_px_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_upgrade_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/colorAccentRed"
        android:gravity="center"
        android:id="@+id/tv_upgrade_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_50"
        android:layout_marginStart="@dimen/qb_px_32"
        android:layout_marginEnd="@dimen/qb_px_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pb_upgrade"/>
</androidx.constraintlayout.widget.ConstraintLayout>
