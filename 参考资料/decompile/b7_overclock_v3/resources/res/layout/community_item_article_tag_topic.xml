<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@color/colorPrimaryA08"
    android:paddingTop="@dimen/qb_px_2"
    android:paddingBottom="@dimen/qb_px_2"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/qb_px_8"
    android:paddingEnd="@dimen/qb_px_8">
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:id="@+id/tv_tag_prefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="#"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorPrimary"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
