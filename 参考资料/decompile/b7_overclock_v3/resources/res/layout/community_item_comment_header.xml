<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_56">
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_000000_a90"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_comments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/qb_px_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_000000_a50"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_sort"
        android:paddingTop="@dimen/qb_px_8"
        android:paddingBottom="@dimen/qb_px_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/community_order_by_time"
        android:drawablePadding="@dimen/qb_px_4"
        android:drawableStart="@drawable/community_ic_sort"
        android:paddingStart="@dimen/qb_px_16"
        android:paddingEnd="@dimen/qb_px_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:layout_gravity="center_horizontal"
        android:background="@color/color_000000_a04"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
