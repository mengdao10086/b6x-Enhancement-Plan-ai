<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_gravity="center"
        android:background="@drawable/device_bg_round_corner_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp">
        <TextView
            android:textSize="17sp"
            android:textColor="@color/colorTextPrimary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"/>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="16dp"
            android:foreground="?attr/actionBarItemBackground"
            android:src="@drawable/device_ic_close_cross"
            android:scaleType="center"
            android:layout_marginEnd="16dp"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:id="@+id/tv_version_info_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/device_version_info"
            android:layout_below="@+id/tv_title"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_info"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:fillViewport="true"
            android:layout_below="@+id/tv_version_info_notice"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/colorTextPrimary"
                    android:id="@+id/tv_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:id="@+id/view_divider"
            android:background="@color/colorDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/nsv_info"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/confirm"
            android:layout_below="@+id/view_divider"/>
    </RelativeLayout>
</LinearLayout>
