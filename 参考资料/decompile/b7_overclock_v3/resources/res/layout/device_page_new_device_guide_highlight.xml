<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/qb_px_5"
    android:layout_marginStart="@dimen/qb_px_40"
    android:layout_marginEnd="@dimen/qb_px_40">
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="@dimen/qb_px_24"
        android:layout_height="@dimen/qb_px_36"
        android:src="@drawable/icon_saw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_guide"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textColor="@color/color_white"
        android:id="@+id/tv_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_arrow"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
