<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_000000_a04"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="@color/color_white"
        android:paddingTop="@dimen/qb_px_8"
        android:paddingBottom="@dimen/qb_px_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/qb_px_16"
        android:paddingEnd="@dimen/qb_px_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <EditText
            android:textSize="@dimen/sp_12"
            android:textColorHint="@color/color_000000_a30"
            android:id="@+id/editor"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_32"
            android:hint="@string/community_say_something"
            android:singleLine="true"
            android:imeOptions="actionSend">
            <requestFocus/>
        </EditText>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
