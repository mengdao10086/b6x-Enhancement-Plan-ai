<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_wait_click"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:background="@color/color_black_33"
        android:layout_width="@dimen/qb_px_225"
        android:layout_height="@dimen/qb_px_140">
        <top.androidman.SuperButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/qb_px_36"
            android:layout_height="@dimen/qb_px_36"
            app:background_normalColor="@color/transparent"
            app:icon="@drawable/ic_close"
            app:iconColor="@color/color_ffffff_a60"
            app:iconHeight="@dimen/qb_px_8"
            app:iconWidth="@dimen/qb_px_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_white"
            android:gravity="center"
            android:id="@+id/wait_click_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_16"
            android:text="@string/floatview_combo_key_listen_hint"
            android:layout_marginStart="@dimen/qb_px_16"
            android:layout_marginEnd="@dimen/qb_px_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_close"/>
        <TextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_white"
            android:id="@+id/tv_and"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/key_plus"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/wait_click_text"/>
        <com.flydigi.float_view.widget.ExpandView
            android:id="@+id/ev_combo_first"
            android:layout_width="@dimen/qb_px_32"
            android:layout_height="@dimen/qb_px_32"
            android:layout_marginEnd="@dimen/qb_px_12"
            app:layout_constraintBottom_toBottomOf="@+id/tv_and"
            app:layout_constraintEnd_toStartOf="@+id/tv_and"
            app:layout_constraintTop_toTopOf="@+id/tv_and"/>
        <com.flydigi.float_view.widget.ExpandView
            android:id="@+id/ev_combo_second"
            android:layout_width="@dimen/qb_px_32"
            android:layout_height="@dimen/qb_px_32"
            android:layout_marginStart="@dimen/qb_px_12"
            app:layout_constraintBottom_toBottomOf="@+id/tv_and"
            app:layout_constraintStart_toEndOf="@+id/tv_and"
            app:layout_constraintTop_toTopOf="@+id/tv_and"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
