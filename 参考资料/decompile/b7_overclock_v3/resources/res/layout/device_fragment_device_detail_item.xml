<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingBottom="@dimen/qb_px_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="0dp"
    android:paddingEnd="@dimen/qb_px_8">
    <ImageView
        android:id="@+id/iv_device"
        android:layout_width="@dimen/qb_px_144"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/qb_px_8"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_28"
        android:textStyle="bold"
        android:textColor="@color/color_000000_a90"
        android:id="@+id/tv_device_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_24"
        android:layout_marginStart="@dimen/qb_px_16"
        android:layout_marginEnd="@dimen/qb_px_8"
        app:layout_constraintEnd_toStartOf="@+id/iv_device"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/area_connect_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_8"
        app:layout_constraintStart_toStartOf="@+id/tv_device_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_device_name">
        <ImageView
            android:id="@+id/iv_battery"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/view_divider1"
            android:background="@color/color_000000_a10"
            android:visibility="gone"
            android:layout_width="@dimen/qb_px_1"
            android:layout_height="@dimen/qb_px_10"
            android:layout_marginStart="@dimen/qb_px_8"
            android:layout_marginEnd="@dimen/qb_px_8"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:id="@+id/tv_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/view_divider2"
            android:background="@color/color_gray_96"
            android:layout_width="@dimen/qb_px_1"
            android:layout_height="@dimen/qb_px_10"
            android:layout_marginStart="@dimen/qb_px_8"
            android:layout_marginEnd="@dimen/qb_px_8"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_000000_a90"
            android:id="@+id/tv_mapping_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_000000_a50"
        android:id="@+id/tv_tech_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_16"
        android:text="@string/device_slogan_apex"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/qb_px_8"
        app:layout_constraintEnd_toStartOf="@+id/iv_device"
        app:layout_constraintStart_toStartOf="@+id/tv_device_name"
        app:layout_constraintTop_toBottomOf="@+id/area_connect_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
