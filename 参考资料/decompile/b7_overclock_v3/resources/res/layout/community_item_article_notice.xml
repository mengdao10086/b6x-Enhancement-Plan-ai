<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_000000_a04"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_36"
    android:layout_marginTop="@dimen/qb_px_16"
    android:layout_marginStart="@dimen/qb_px_16"
    android:layout_marginEnd="@dimen/qb_px_16">
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/colorAccentRed"
        android:id="@+id/tv_tag"
        android:background="@color/colorAccentRedA10"
        android:paddingTop="@dimen/qb_px_1"
        android:paddingBottom="@dimen/qb_px_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/qb_px_2"
        android:paddingEnd="@dimen/qb_px_2"
        android:layout_marginStart="@dimen/qb_px_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_000000_a90"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/qb_px_4"
        android:layout_marginEnd="@dimen/qb_px_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
        app:layout_constraintStart_toEndOf="@+id/tv_tag"
        app:layout_constraintTop_toTopOf="parent"/>
    <top.androidman.SuperButton
        android:id="@+id/iv_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/qb_px_14"
        app:background_normalColor="@color/transparent"
        app:icon="@drawable/ic_jiantou_right"
        app:iconColor="@color/color_000000_a30"
        app:iconHeight="@dimen/qb_px_10"
        app:iconWidth="@dimen/qb_px_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
