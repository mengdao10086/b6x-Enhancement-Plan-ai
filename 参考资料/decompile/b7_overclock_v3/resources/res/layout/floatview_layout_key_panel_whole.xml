<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layout_whole"
        android:layout_width="@dimen/qb_px_330"
        android:layout_height="@dimen/qb_px_234">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="@dimen/qb_px_40"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/btn_key_basic"
                android:background="@drawable/selector_bg_color_config_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <View
                    android:id="@+id/indicator_key_basic"
                    android:background="@color/colorPrimary"
                    android:layout_width="@dimen/qb_px_2"
                    android:layout_height="match_parent"
                    android:layout_alignTop="@+id/tv_key_basic"
                    android:layout_alignBottom="@+id/tv_key_basic"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="@color/selector_text_color_normal"
                    android:gravity="center"
                    android:id="@+id/tv_key_basic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/floatview_key_basic"
                    android:layout_centerInParent="true"
                    android:lineSpacingMultiplier="1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/btn_key_other"
                android:background="@drawable/selector_bg_color_config_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <View
                    android:id="@+id/indicator_key_other"
                    android:background="@color/colorPrimary"
                    android:layout_width="@dimen/qb_px_2"
                    android:layout_height="match_parent"
                    android:layout_alignTop="@+id/tv_key_other"
                    android:layout_alignBottom="@+id/tv_key_other"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="@color/selector_text_color_normal"
                    android:gravity="center"
                    android:id="@+id/tv_key_other"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/floatview_key_other"
                    android:layout_centerInParent="true"
                    android:lineSpacingMultiplier="1"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/btn_key_combination"
                android:background="@drawable/selector_bg_color_config_panel"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <View
                    android:id="@+id/indicator_key_combination"
                    android:background="@color/colorPrimary"
                    android:layout_width="@dimen/qb_px_2"
                    android:layout_height="match_parent"
                    android:layout_alignTop="@+id/tv_key_combination"
                    android:layout_alignBottom="@+id/tv_key_combination"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="@dimen/sp_11"
                    android:textColor="@color/selector_text_color_normal"
                    android:gravity="center"
                    android:id="@+id/tv_key_combination"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/floatview_key_combination"
                    android:layout_centerInParent="true"
                    android:lineSpacingMultiplier="1"/>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:background="@color/color_101010_a75"
            android:layout_width="@dimen/qb_px_290"
            android:layout_height="match_parent">
            <include
                android:id="@+id/panel_key_basic"
                layout="@layout/floatview_layout_gamepad_whole_single_key"/>
            <include
                android:id="@+id/panel_key_other"
                android:visibility="gone"
                layout="@layout/floatview_layout_gamepad_whole_other_key"/>
            <include
                android:id="@+id/panel_key_combination"
                android:visibility="gone"
                layout="@layout/floatview_layout_gamepad_whole_double_key"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
