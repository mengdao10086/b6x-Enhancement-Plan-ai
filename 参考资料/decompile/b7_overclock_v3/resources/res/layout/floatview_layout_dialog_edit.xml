<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/rl_root"
    android:background="@color/transparent_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/floatview_bg_dialog"
        android:paddingTop="@dimen/qb_px_12"
        android:layout_width="@dimen/qb_px_270"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_ffffff_a90"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            android:singleLine="true"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_ffffff_a90"
            android:gravity="center_vertical"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            android:layout_marginStart="@dimen/qb_px_20"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_16"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_marginEnd="@dimen/qb_px_20">
            <EditText
                android:textSize="@dimen/sp_13"
                android:textColor="@color/color_white"
                android:ellipsize="end"
                android:id="@+id/et_text"
                android:background="@drawable/floatview_bg_edit_text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_28"
                android:singleLine="true"
                android:paddingStart="@dimen/qb_px_8"
                android:paddingEnd="@dimen/qb_px_24"/>
            <ImageView
                android:id="@+id/btn_clear"
                android:visibility="gone"
                android:layout_width="@dimen/qb_px_24"
                android:layout_height="@dimen/qb_px_24"
                android:src="@drawable/floatingsetting_icon_clear"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_6"
            android:layout_marginBottom="@dimen/qb_px_6">
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_ffffff_a50"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:layout_width="@dimen/qb_px_48"
                android:layout_height="@dimen/qb_px_48"
                android:text="@string/cancel"
                android:layout_marginEnd="@dimen/qb_px_20"/>
            <TextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:id="@+id/tv_ok"
                android:layout_width="@dimen/qb_px_48"
                android:layout_height="@dimen/qb_px_48"
                android:text="@string/confirm"
                android:layout_marginEnd="@dimen/qb_px_10"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
