<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/area_root"
    android:background="@drawable/device_selector_bg_device_category"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_56">
    <View
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_flag"
        android:background="@color/colorPrimary"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_5"
        android:layout_height="@dimen/qb_px_24"/>
    <TextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_000000_a50"
        android:gravity="center"
        android:id="@+id/tv_category_name"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
