<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_parent"
    android:background="@color/color_black_7F00"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_white_10"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="12dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/color_black_33"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="20dp"
            android:text="体感设置"/>
        <ScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="310dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_black_33"
                        android:id="@+id/key_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="体感按键"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorTextTertiary"
                        android:id="@+id/key_notice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16px"
                        android:text="（按下你想要的键即可）"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal"
                    android:id="@+id/layout_key_1"
                    android:background="@drawable/cjzc_bg_listen_white"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginLeft="25dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginRight="25dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/color_black_303032"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前按键 "/>
                    <ImageView
                        android:id="@+id/image_basic_key"
                        android:layout_width="50dp"
                        android:layout_height="20dp"
                        android:src="@drawable/flydigi_gp_key_select"
                        android:scaleType="fitCenter"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/color_black_33"
                        android:id="@+id/senty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="体感灵敏度"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/colorTextTertiary"
                        android:ellipsize="end"
                        android:id="@+id/senty_notice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="（推荐设置20，越大转速越快 ）"
                        android:singleLine="true"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginRight="20dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <include
                            android:id="@+id/layout_bar_1"
                            layout="@layout/device_cjzc_listen_special_seekbar"/>
                        <View
                            android:layout_width="5dp"
                            android:layout_height="35dp"/>
                        <include
                            android:id="@+id/layout_bar_2"
                            layout="@layout/device_cjzc_listen_special_seekbar"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:id="@+id/layout_locking"
                        android:layout_width="40dp"
                        android:layout_height="match_parent">
                        <View
                            android:id="@+id/view_line_1"
                            android:background="@color/color_gray_99999F"
                            android:layout_width="20dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"/>
                        <View
                            android:id="@+id/view_line_2"
                            android:background="@color/color_gray_99999F"
                            android:layout_width="20dp"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:layout_alignParentBottom="true"/>
                        <View
                            android:id="@+id/view_line_3"
                            android:background="@color/color_gray_99999F"
                            android:layout_width="1dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="12dp"
                            android:layout_centerHorizontal="true"/>
                        <View
                            android:id="@+id/view_line_4"
                            android:background="@color/color_gray_99999F"
                            android:layout_width="1dp"
                            android:layout_height="18dp"
                            android:layout_marginBottom="12dp"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"/>
                        <ImageView
                            android:id="@+id/iv_locking_1"
                            android:background="@drawable/flydigi_sync_no"
                            android:layout_width="20dp"
                            android:layout_height="24dp"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                </LinearLayout>
                <TextView
                    android:background="@color/base_color_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginLeft="20dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="20dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="21dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_black_33"
                        android:layout_width="0px"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:text="高级设置"
                        android:layout_weight="1"/>
                    <ImageView
                        android:id="@+id/advanced_setting"
                        android:background="@drawable/flydigi_btn_switch_off"
                        android:layout_width="38dp"
                        android:layout_height="21dp"
                        android:layout_marginRight="25dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_advanced_setting"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_black_33"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="切换灵敏度按键"/>
                        <TextView
                            android:textSize="12dp"
                            android:textColor="@color/colorTextTertiary"
                            android:id="@+id/senior_senty_notice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="（按住可切换体感灵敏度）"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal"
                        android:id="@+id/layout_key_2"
                        android:background="@drawable/cjzc_bg_listen_white"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginLeft="25dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginRight="25dp">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="@color/color_black_303032"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="当前按键 "/>
                        <ImageView
                            android:id="@+id/image_senior_key"
                            android:layout_width="50dp"
                            android:layout_height="20dp"
                            android:src="@drawable/flydigi_gp_key_select"
                            android:scaleType="fitCenter"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="16dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/color_black_33"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="切换时灵敏度"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/colorTextTertiary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text=""/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="20dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginRight="20dp">
                        <include
                            android:id="@+id/layout_bar_3"
                            layout="@layout/device_cjzc_listen_special_seekbar"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="100dp"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:background="@color/base_color_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0px"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_black_33"
                android:gravity="center"
                android:id="@+id/cancel"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:text="取消"
                android:layout_weight="1"/>
            <View
                android:background="@color/base_color_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/color_black_33"
                android:gravity="center"
                android:id="@+id/confirm"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:text="确定"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
