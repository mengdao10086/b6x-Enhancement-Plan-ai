<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qb_px_48">
    <TextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_000000_a90"
        android:id="@+id/tv_category_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <View
        android:background="@color/color_000000_a30"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/qb_px_24"
        android:layout_marginEnd="@dimen/qb_px_10"
        android:layout_toStartOf="@+id/tv_category_name"
        android:layout_alignParentStart="true"/>
    <View
        android:background="@color/color_000000_a30"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/qb_px_10"
        android:layout_marginEnd="@dimen/qb_px_24"
        android:layout_toEndOf="@+id/tv_category_name"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
