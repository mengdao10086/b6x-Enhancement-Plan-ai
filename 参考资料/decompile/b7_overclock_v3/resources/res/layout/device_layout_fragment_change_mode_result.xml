<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_status_image"
        android:background="@drawable/device_connection_succeed"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginTop="60dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/colorTextPrimary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="已切换到Flashplay™智连模式"/>
    <TextView
        android:textColor="@color/colorTextTertiary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="固件版本 "/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_next"
        android:background="@drawable/selector_bg_action_button"
        android:layout_width="310dp"
        android:layout_height="48dp"
        android:layout_marginTop="250dp"/>
</LinearLayout>
