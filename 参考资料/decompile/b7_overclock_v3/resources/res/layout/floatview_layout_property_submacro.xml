<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_000000_a40"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_top"
        android:background="@color/lib_color_7"
        android:layout_width="0dp"
        android:layout_height="@dimen/qb_px_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/lib_color_9"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/floatview_property_key_title"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/lib_color_10"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="@dimen/qb_px_88"
            android:layout_height="match_parent"
            android:text="@string/cancel"
            android:layout_marginEnd="@dimen/qb_px_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_ok"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:layout_gravity="center_vertical"
            android:background="@color/lib_color_10"
            android:layout_width="@dimen/qb_px_1"
            android:layout_height="@dimen/qb_px_14"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_ok"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:layout_width="@dimen/qb_px_88"
            android:layout_height="match_parent"
            android:text="@string/confirm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_macro"
        android:background="@color/lib_color_12"
        android:paddingLeft="@dimen/qb_px_12"
        android:paddingRight="@dimen/qb_px_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_top">
        <com.flydigi.float_view.widget.FloatViewSingleSeekBarView
            android:id="@+id/ssb_period"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:floatview_ssb_name="@string/floatview_property_macro_key_interval_time"
            app:floatview_ssb_show_unit="true"
            app:floatview_ssb_unit="0.015"
            app:floatview_ssb_unit_name="@string/floatview_unit_second"
            app:floatview_ssb_value_default="2"
            app:floatview_ssb_value_format="3"
            app:floatview_ssb_value_max="255"
            app:floatview_ssb_value_min="0"/>
        <Space
            android:layout_width="@dimen/qb_px_8"
            android:layout_height="wrap_content"/>
        <com.flydigi.float_view.widget.FloatViewSingleSeekBarView
            android:id="@+id/ssb_hold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:floatview_ssb_name="@string/floatview_property_macro_key_duration"
            app:floatview_ssb_show_unit="true"
            app:floatview_ssb_unit="0.015"
            app:floatview_ssb_unit_name="@string/floatview_unit_second"
            app:floatview_ssb_value_default="2"
            app:floatview_ssb_value_format="3"
            app:floatview_ssb_value_max="255"
            app:floatview_ssb_value_min="1"/>
    </LinearLayout>
    <View
        android:background="@color/lib_color_35"
        android:layout_width="0dp"
        android:layout_height="@dimen/qb_px_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_macro"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/listview_1"
        android:background="@color/lib_color_12"
        android:layout_width="@dimen/qb_px_120"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/qb_px_1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_macro"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/listview_2"
        android:background="@color/lib_color_13"
        android:layout_width="@dimen/qb_px_120"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/qb_px_1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/listview_1"
        app:layout_constraintTop_toBottomOf="@+id/layout_macro"/>
    <ScrollView
        android:background="#232323"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/qb_px_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/listview_2"
        app:layout_constraintTop_toBottomOf="@+id/layout_macro">
        <FrameLayout
            android:id="@+id/area_property_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <include
        android:id="@+id/layout_question"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_0"
        android:layout_height="@dimen/qb_px_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/floatview_widget_help_dialog"/>
    <include
        android:id="@+id/layout_wait_click"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_0"
        android:layout_height="@dimen/qb_px_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/floatview_widget_key_listen"/>
</androidx.constraintlayout.widget.ConstraintLayout>
