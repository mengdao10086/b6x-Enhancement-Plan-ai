<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/layout_toolbar"/>
    <top.androidman.SuperButton
        android:id="@+id/iv_result"
        android:layout_width="@dimen/qb_px_80"
        android:layout_height="@dimen/qb_px_80"
        android:layout_marginTop="@dimen/qb_px_108"
        app:icon="@drawable/cf_ic_update_success"
        app:iconColor="@color/colorPrimary"
        app:iconHeight="@dimen/qb_px_80"
        app:iconWidth="@dimen/qb_px_80"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_000000_a90"
        android:id="@+id/tv_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_16"
        app:layout_constraintEnd_toEndOf="@+id/iv_result"
        app:layout_constraintStart_toStartOf="@+id/iv_result"
        app:layout_constraintTop_toBottomOf="@+id/iv_result"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/colorAccentRed"
        android:gravity="center"
        android:id="@+id/tv_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_16"
        android:layout_marginStart="@dimen/qb_px_32"
        android:layout_marginEnd="@dimen/qb_px_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_result"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_ffffff_a90"
        android:gravity="center"
        android:id="@+id/btn_action"
        android:background="@drawable/selector_bg_action_button"
        android:layout_width="@dimen/qb_px_148"
        android:layout_height="@dimen/qb_px_36"
        android:layout_marginBottom="@dimen/qb_px_64"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
