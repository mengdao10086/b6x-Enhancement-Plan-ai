<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_fz_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/colorTextPrimary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <EditText
        android:textSize="15sp"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/color_000000_a30"
        android:ellipsize="end"
        android:id="@+id/et_rename"
        android:background="@drawable/mian_bg_edit_text_rename"
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:maxLines="1"
        android:singleLine="true"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="21dp"
        android:layout_marginEnd="21dp"/>
    <View
        android:background="#d3d3d3"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_double"
            android:layout_width="match_parent"
            android:layout_height="47dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#515151"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/selector_fz_dialog_left_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <View
                android:background="#d3d3d3"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/selector_fz_dialog_right_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/confirm"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
