<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@color/transparent_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="@dimen/qb_px_240"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/top"
            android:background="@drawable/bg_fz_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_13">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/lib_color_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_16"
                android:text="@string/notice"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/color_gray_99999F"
                android:id="@+id/tv_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/qb_px_15"
                android:layout_marginTop="@dimen/qb_px_6"
                android:layout_marginRight="@dimen/qb_px_15"
                android:text="@string/floatview_game_config_notice_for_unsuited_ratio"/>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_setting"
                android:layout_width="@dimen/qb_px_208"
                android:layout_height="@dimen/qb_px_116"
                android:layout_marginTop="@dimen/qb_px_10"
                android:src="@drawable/float_view_icon_notice_config_unsuited"
                android:scaleType="fitCenter"/>
            <View
                android:background="@drawable/divider_line"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="@dimen/qb_px_10"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/qb_px_44">
                <Button
                    android:textSize="14sp"
                    android:textColor="#515151"
                    android:gravity="center"
                    android:id="@+id/btn_cancel"
                    android:background="@drawable/selector_fz_dialog_left_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/qb_px_1"/>
                <View
                    android:background="#d3d3d3"
                    android:layout_width="1px"
                    android:layout_height="match_parent"/>
                <Button
                    android:textSize="14sp"
                    android:textColor="@color/colorPrimary"
                    android:gravity="center"
                    android:id="@+id/btn_ok"
                    android:background="@drawable/selector_fz_dialog_right_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/floatview_detailed_tutorial"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/qb_px_1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/layout_cancel_notice"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/qb_px_44"
            android:layout_marginTop="@dimen/qb_px_6"
            android:minWidth="@dimen/qb_px_128"
            android:layout_below="@+id/top"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/iv_cancel_notice"
                android:layout_width="@dimen/qb_px_14"
                android:layout_height="@dimen/qb_px_14"
                android:src="@drawable/float_view_icon_checkbox_green_no"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/color_ffffff_a50"
                android:gravity="center"
                android:id="@+id/tv_notice_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/qb_px_12"
                android:text="@string/no_more_notice"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
