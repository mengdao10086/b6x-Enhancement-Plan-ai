<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_fz_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/colorTextPrimary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_40"
        android:text="@string/game_net_status_notice"/>
    <TextView
        android:textSize="@dimen/sp_15"
        android:textColor="@color/colorTextSecondary"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/qb_px_20"
        android:layout_marginTop="@dimen/qb_px_12"
        android:layout_marginRight="@dimen/qb_px_20"
        android:layout_marginBottom="@dimen/qb_px_20"
        android:text="@string/game_data_net_notice"
        android:lineSpacingExtra="@dimen/qb_px_4"/>
    <View
        android:background="#d3d3d3"
        android:layout_width="match_parent"
        android:layout_height="@dimen/qb_px_1"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_double"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_48">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="#515151"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:background="@drawable/selector_fz_dialog_left_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/cancel"
                android:layout_weight="1"/>
            <View
                android:background="#d3d3d3"
                android:layout_width="@dimen/qb_px_1"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:background="@drawable/selector_fz_dialog_right_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/game_use_data_download"
                android:layout_weight="1"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
