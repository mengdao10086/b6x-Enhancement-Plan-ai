<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="@dimen/qb_px_270"
        android:layout_height="@dimen/qb_px_170"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_black"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_20"
            android:text="@string/device_driver_active_failed"
            android:layout_marginStart="@dimen/qb_px_16"
            android:layout_marginEnd="@dimen/qb_px_16"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_000000_a90"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            android:text="@string/device_driver_active_failed_reason"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_marginEnd="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_000000_a90"
            android:gravity="center_vertical"
            android:id="@+id/tv_option_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            android:text="@string/device_driver_active_permission_usb_debugable"
            android:drawablePadding="@dimen/qb_px_10"
            android:drawableStart="@drawable/device_ic_success"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_marginEnd="@dimen/qb_px_20"/>
        <TextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_000000_a90"
            android:gravity="center_vertical"
            android:id="@+id/tv_option_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            android:text="@string/floatview_usb_debug_enable_content_usb_debug_safe_1"
            android:drawablePadding="@dimen/qb_px_10"
            android:drawableStart="@drawable/device_ic_error"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_marginEnd="@dimen/qb_px_20"/>
        <View
            android:background="@drawable/base_view_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/qb_px_16"
            android:layout_marginStart="@dimen/qb_px_4"
            android:layout_marginEnd="@dimen/qb_px_4"/>
        <TextView
            android:enabled="false"
            android:textSize="@dimen/sp_16"
            android:textColor="@color/selector_button_text_colored"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_action"
            android:background="@drawable/selector_fz_dialog_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_44"
            android:text="@string/device_go_to_setting"/>
    </LinearLayout>
</FrameLayout>
