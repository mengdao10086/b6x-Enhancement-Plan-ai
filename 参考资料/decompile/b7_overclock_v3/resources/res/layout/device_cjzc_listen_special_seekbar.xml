<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="24dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_black_33"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="左右"/>
        <Button
            android:id="@+id/btn_minus"
            android:background="@drawable/flydigi_btn_decrease_blue"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginLeft="10dp"/>
        <SeekBar
            android:id="@+id/seekbar"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:progress="100"
            android:progressDrawable="@drawable/device_cjzc_seekbar_value"
            android:thumb="@drawable/device_cjzc_seekbar_thumb"
            android:thumbOffset="0px"
            android:layout_weight="1"
            android:layout_centerVertical="true"/>
        <Button
            android:id="@+id/btn_plus"
            android:background="@drawable/flydigi_btn_increase_blue"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/color_black_33"
            android:gravity="center"
            android:id="@+id/value"
            android:background="@drawable/device_cjzc_bg_gray_4_stroke_gray_2"
            android:layout_width="35dp"
            android:layout_height="24dp"
            android:layout_marginLeft="15dp"
            android:text="66"
            android:singleLine="true"/>
    </LinearLayout>
</RelativeLayout>
