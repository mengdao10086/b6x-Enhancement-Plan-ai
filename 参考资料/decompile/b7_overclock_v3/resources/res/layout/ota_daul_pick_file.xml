<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="10dp"
    android:layout_width="360dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:id="@+id/dual_pick_file_left_title"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:text="@string/pick_ota_file_left"/>
    <TextView
        android:id="@+id/ota_file_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:text="--"/>
    <Button
        android:layout_gravity="right"
        android:id="@+id/pick_ota_file_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="140dp"
        android:minHeight="40dp"
        android:text="@string/pick_ota_file"/>
    <TextView
        android:textSize="20sp"
        android:id="@+id/dual_pick_file_right_title"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:text="@string/pick_ota_file_right"/>
    <TextView
        android:id="@+id/ota_file_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5dp"
        android:text="--"/>
    <Button
        android:layout_gravity="right"
        android:id="@+id/pick_ota_file_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="140dp"
        android:minHeight="40dp"
        android:text="@string/pick_ota_file"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <Button
            android:id="@+id/ok_dual_pick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/cancel_dual_pick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/cancel"/>
    </LinearLayout>
    <TextView
        android:textColor="#ff0000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/choose_new_file_tips"/>
</LinearLayout>
