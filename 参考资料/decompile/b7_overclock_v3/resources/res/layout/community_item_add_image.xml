<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/qb_px_100"
    android:layout_height="@dimen/qb_px_100">
    <ImageView
        android:id="@+id/iv_image"
        android:background="@color/color_000000_a04"
        android:layout_width="@dimen/qb_px_0"
        android:layout_height="@dimen/qb_px_0"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <top.androidman.SuperButton
        android:id="@+id/btn_remove"
        android:visibility="gone"
        android:layout_width="@dimen/qb_px_24"
        android:layout_height="@dimen/qb_px_24"
        android:scaleType="centerInside"
        app:background_normalColor="@color/color_000000_a50"
        app:icon="@drawable/ic_close"
        app:iconColor="@color/color_ffffff_a90"
        app:iconHeight="@dimen/qb_px_12"
        app:iconWidth="@dimen/qb_px_12"
        app:layout_constraintStart_toStartOf="@+id/iv_image"
        app:layout_constraintTop_toTopOf="@+id/iv_image"/>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_white"
        android:id="@+id/tv_addon_count"
        android:background="@color/color_000000_a04"
        android:paddingTop="@dimen/qb_px_2"
        android:paddingBottom="@dimen/qb_px_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/qb_px_4"
        android:paddingEnd="@dimen/qb_px_4"
        app:layout_constraintEnd_toEndOf="@+id/iv_image"
        app:layout_constraintTop_toTopOf="@+id/iv_image"/>
</androidx.constraintlayout.widget.ConstraintLayout>
