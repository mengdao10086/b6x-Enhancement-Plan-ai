<?xml version="1.0" encoding="utf-8"?>
<top.androidman.SuperLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/area_customer_service_notice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:background_normalColor="#a7a8b3"
    app:clickable="false"
    app:corner="@dimen/qb_px_18"
    app:elevation="@dimen/qb_px_6"
    app:shadow_endColor="@color/color_000000_a20"
    app:shadow_size="@dimen/qb_px_1"
    app:shadow_startColor="#a7a8b3">
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/color_white"
        android:layout_gravity="center_vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_customer_service_notice"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/qb_px_20"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_end"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/app_end"
        android:paddingStart="@dimen/qb_px_12"
        android:paddingEnd="@dimen/qb_px_12"/>
    <TextView
        android:textSize="@dimen/sp_13"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/btn_continue"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:text="@string/continue_"
        android:paddingStart="@dimen/qb_px_12"
        android:paddingEnd="@dimen/qb_px_12"
        android:layout_marginEnd="@dimen/qb_px_8"/>
</top.androidman.SuperLinearLayout>
