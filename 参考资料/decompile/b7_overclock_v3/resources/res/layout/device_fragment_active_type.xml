<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/sp_20"
            android:textStyle="bold"
            android:textColor="@color/color_000000_a90"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_30"
            android:text="@string/device_driver_active_type"
            android:layout_marginStart="@dimen/qb_px_24"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_000000_a90"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_10"
            android:text="@string/device_driver_active_desc_wasp"
            android:layout_marginStart="@dimen/qb_px_24"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/area_active_by_wadb"
            android:background="@drawable/device_shape_bg_000000_a50"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_88"
            android:layout_marginTop="@dimen/qb_px_20"
            android:layout_marginStart="@dimen/qb_px_24"
            android:layout_marginEnd="@dimen/qb_px_24">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_000000_a90"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_active_by_wadb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_driver_active_by_wadb"
                android:drawablePadding="@dimen/qb_px_8"
                app:drawableStartCompat="@drawable/device_ic_wadb"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_000000_a50"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_active_by_wadb_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_13"
                android:text="@string/device_driver_active_by_wadb_desc"
                android:layout_marginStart="@dimen/qb_px_16"
                android:layout_marginEnd="@dimen/qb_px_16"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/area_active_by_utool"
            android:background="@drawable/device_shape_bg_000000_a50"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_88"
            android:layout_marginTop="@dimen/qb_px_20"
            android:layout_marginStart="@dimen/qb_px_24"
            android:layout_marginEnd="@dimen/qb_px_24">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_000000_a90"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_active_by_utool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_driver_active_by_utool"
                android:drawablePadding="@dimen/qb_px_8"
                app:drawableStartCompat="@drawable/ic_usb"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_000000_a50"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_active_by_utool_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_13"
                android:text="@string/device_driver_active_by_utool_desc"
                android:layout_marginStart="@dimen/qb_px_16"
                android:layout_marginEnd="@dimen/qb_px_16"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/area_active_by_pc"
            android:background="@drawable/device_shape_bg_000000_a50"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_88"
            android:layout_marginTop="@dimen/qb_px_20"
            android:layout_marginStart="@dimen/qb_px_24"
            android:layout_marginEnd="@dimen/qb_px_24">
            <TextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/color_000000_a90"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_active_by_pc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_driver_active_by_pc"
                android:drawablePadding="@dimen/qb_px_8"
                app:drawableStartCompat="@drawable/ic_computer"/>
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_000000_a50"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_active_by_pc_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/qb_px_13"
                android:text="@string/device_driver_active_by_pc_desc"
                android:layout_marginStart="@dimen/qb_px_16"
                android:layout_marginEnd="@dimen/qb_px_16"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorPrimary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_switch_to_flashplay_mode"
            android:paddingTop="@dimen/qb_px_8"
            android:paddingBottom="@dimen/qb_px_8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_16"
            android:text="@string/device_driver_active_switch_to_flashplay"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
