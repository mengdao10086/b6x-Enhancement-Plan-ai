<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/lib_color_37"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/tv_config_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="@dimen/qb_px_330"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qb_px_48"
            android:layout_marginBottom="@dimen/qb_px_4">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/color_000000_a75"
                android:layout_width="@dimen/qb_px_270"
                android:layout_height="match_parent">
                <FrameLayout
                    android:id="@+id/button_menu_move_bar"
                    android:layout_width="@dimen/qb_px_32"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/qb_px_10"
                        android:layout_height="@dimen/qb_px_12"
                        android:src="@drawable/floatview_ic_move"
                        android:scaleType="centerCrop"/>
                </FrameLayout>
                <top.androidman.SuperButton
                    android:id="@+id/btn_save_as"
                    android:layout_width="@dimen/qb_px_56"
                    android:layout_height="@dimen/qb_px_48"
                    app:background_normalColor="@color/transparent"
                    app:icon="@drawable/ic_save"
                    app:iconColor="@color/color_white"
                    app:iconHeight="@dimen/qb_px_16"
                    app:iconOrientation="top"
                    app:iconPadding="@dimen/qb_px_4"
                    app:iconWidth="@dimen/qb_px_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_test"
                    app:layout_constraintStart_toEndOf="@+id/button_menu_move_bar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:text="@string/floatview_save_as"
                    app:textColor="@color/color_white"
                    app:textSize="@dimen/sp_9"/>
                <top.androidman.SuperButton
                    android:id="@+id/btn_test"
                    android:layout_width="@dimen/qb_px_56"
                    android:layout_height="@dimen/qb_px_48"
                    app:background_normalColor="@color/transparent"
                    app:icon="@drawable/ic_test"
                    app:iconColor="@color/color_white"
                    app:iconHeight="@dimen/qb_px_16"
                    app:iconOrientation="top"
                    app:iconPadding="@dimen/qb_px_4"
                    app:iconWidth="@dimen/qb_px_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btn_cancel"
                    app:layout_constraintStart_toEndOf="@+id/btn_save_as"
                    app:layout_constraintTop_toTopOf="parent"
                    app:text="@string/floatview_test"
                    app:textColor="@color/color_white"
                    app:textSize="@dimen/sp_9"/>
                <top.androidman.SuperButton
                    android:gravity="center"
                    android:id="@+id/btn_cancel"
                    android:layout_width="@dimen/qb_px_56"
                    android:layout_height="@dimen/qb_px_48"
                    app:background_normalColor="@color/transparent"
                    app:icon="@drawable/ic_close"
                    app:iconColor="@color/color_white"
                    app:iconHeight="@dimen/qb_px_16"
                    app:iconOrientation="top"
                    app:iconPadding="@dimen/qb_px_4"
                    app:iconWidth="@dimen/qb_px_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/btn_test"
                    app:layout_constraintTop_toTopOf="parent"
                    app:text="@string/cancel"
                    app:textColor="@color/color_white"
                    app:textSize="@dimen/sp_9"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <Space
                android:layout_width="@dimen/qb_px_4"
                android:layout_height="wrap_content"/>
            <top.androidman.SuperButton
                android:id="@+id/btn_apply"
                android:layout_width="@dimen/qb_px_56"
                android:layout_height="@dimen/qb_px_48"
                app:background_normalColor="@color/color_000000_a75"
                app:icon="@drawable/ic_success"
                app:iconColor="@color/color_white"
                app:iconHeight="@dimen/qb_px_16"
                app:iconOrientation="top"
                app:iconPadding="@dimen/qb_px_4"
                app:iconWidth="@dimen/qb_px_16"
                app:text="@string/floatview_save"
                app:textColor="@color/color_white"
                app:textSize="@dimen/sp_9"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/ll_panel_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_expand"
            android:layout_width="@dimen/qb_px_68"
            android:layout_height="@dimen/qb_px_20"
            android:src="@drawable/floatview_ic_expand"/>
    </LinearLayout>
</FrameLayout>
