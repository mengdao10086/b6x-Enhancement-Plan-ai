<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/rl_root"
    android:background="@color/transparent_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/floatview_bg_dialog"
        android:layout_width="@dimen/qb_px_270"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true">
        <top.androidman.SuperButton
            android:id="@+id/btn_close"
            android:visibility="gone"
            android:layout_width="@dimen/qb_px_32"
            android:layout_height="@dimen/qb_px_32"
            android:scaleType="centerInside"
            app:background_normalColor="@color/transparent"
            app:icon="@drawable/ic_close"
            app:iconColor="@color/color_000000_a30"
            app:iconHeight="@dimen/qb_px_16"
            app:iconWidth="@dimen/qb_px_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_ffffff_a90"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_20"
            android:singleLine="true"
            android:layout_marginStart="@dimen/qb_px_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_ffffff_a90"
            android:gravity="center_vertical"
            android:id="@+id/tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_8"
            android:layout_marginStart="@dimen/qb_px_20"
            android:layout_marginEnd="@dimen/qb_px_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <TextView
            android:textSize="@dimen/sp_13"
            android:textColor="@color/color_ffffff_a50"
            android:id="@+id/tv_never_notice"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/qb_px_16"
            android:text="@string/no_more_notice"
            android:drawablePadding="@dimen/qb_px_4"
            android:drawableStart="@drawable/floatingsetting_checkbox_no"
            android:layout_marginStart="@dimen/qb_px_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/qb_px_36"
            android:layout_marginTop="@dimen/qb_px_4"
            android:layout_marginBottom="@dimen/qb_px_4"
            android:text="@string/confirm"
            android:paddingStart="@dimen/qb_px_8"
            android:paddingEnd="@dimen/qb_px_8"
            android:layout_marginEnd="@dimen/qb_px_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_ffffff_a50"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/qb_px_36"
            android:text="@string/cancel"
            android:paddingStart="@dimen/qb_px_8"
            android:paddingEnd="@dimen/qb_px_8"
            android:layout_marginEnd="@dimen/qb_px_8"
            app:layout_constraintBottom_toBottomOf="@+id/tv_ok"
            app:layout_constraintEnd_toStartOf="@+id/tv_ok"
            app:layout_constraintTop_toTopOf="@+id/tv_ok"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
