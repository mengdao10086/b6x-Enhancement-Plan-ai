<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/color_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <top.androidman.SuperButton
        android:id="@+id/iv_result"
        android:layout_width="@dimen/qb_px_80"
        android:layout_height="@dimen/qb_px_80"
        android:layout_marginTop="@dimen/qb_px_108"
        app:icon="@drawable/cf_ic_update_success"
        app:iconColor="@color/colorPrimary"
        app:iconHeight="@dimen/qb_px_80"
        app:iconWidth="@dimen/qb_px_80"/>
    <TextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_000000_a90"
        android:id="@+id/tv_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_16"
        android:text="@string/device_cloud_sync_share_success"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_000000_a90"
        android:id="@+id/tv_game_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_16"
        android:layout_marginStart="@dimen/qb_px_32"
        android:layout_marginEnd="@dimen/qb_px_32"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_000000_a90"
        android:gravity="center"
        android:id="@+id/tv_share_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_4"
        android:layout_marginStart="@dimen/qb_px_32"
        android:layout_marginEnd="@dimen/qb_px_32"/>
    <TextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_000000_a90"
        android:gravity="center"
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qb_px_32"
        android:text="@string/device_cloud_sync_share_hint"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_ffffff_a90"
        android:gravity="center"
        android:id="@+id/btn_action"
        android:background="@drawable/selector_bg_action_button"
        android:layout_width="@dimen/qb_px_148"
        android:layout_height="@dimen/qb_px_36"
        android:layout_marginTop="@dimen/qb_px_32"
        android:text="@string/device_cloud_sync_share_copy_code"/>
</LinearLayout>
