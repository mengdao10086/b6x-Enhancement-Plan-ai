<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#80000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_white_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_black_303032"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="25dp"
            android:text="标题"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/color_black_636366"
            android:gravity="top|left"
            android:id="@+id/tv_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="25dp"
            android:text="按键映射是畅游戏的基础，请激活按键映射后再连接手柄。"
            android:lineSpacingExtra="10dp"/>
        <View
            android:background="@color/color_gray_ccccd2"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="30dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/layout_bottom"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="1px">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorTextTertiary"
                android:gravity="center"
                android:id="@+id/tv_cancel"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:text="取消"
                android:layout_weight="1"/>
            <View
                android:background="@color/color_gray_ccccd2"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:id="@+id/tv_confirm"
                android:layout_width="0px"
                android:layout_height="match_parent"
                android:text="确定"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:gravity="center"
                android:id="@+id/tv_ok"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="确定"
                android:layout_centerHorizontal="true"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
