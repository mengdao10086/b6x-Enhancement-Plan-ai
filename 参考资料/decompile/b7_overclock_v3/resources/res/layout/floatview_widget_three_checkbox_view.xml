<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingTop="@dimen/qb_px_12"
    android:paddingBottom="@dimen/qb_px_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/area_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_ffffff_a90"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/iv_title_help"
                android:background="@drawable/bg_black_20"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:layout_marginLeft="@dimen/qb_px_8"
                android:src="@drawable/float_ic_floatingsetting_icon_question"/>
        </LinearLayout>
        <Space
            android:layout_width="@dimen/qb_px_8"
            android:layout_height="@dimen/qb_px_8"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/area_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/iv_checkbox_1"
                android:layout_width="@dimen/qb_px_24"
                android:layout_height="@dimen/qb_px_24"
                android:src="@drawable/floatview_selector_checkbox"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_ffffff_a90"
                android:gravity="center"
                android:id="@+id/tv_checkbox_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/qb_px_4"
                android:paddingEnd="@dimen/qb_px_4"/>
            <ImageView
                android:id="@+id/iv_checkbox_1_help"
                android:background="@drawable/bg_black_20"
                android:visibility="gone"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/float_ic_floatingsetting_icon_question"
                android:layout_marginStart="@dimen/qb_px_4"/>
            <ImageButton
                android:id="@+id/iv_checkbox_2"
                android:layout_width="@dimen/qb_px_24"
                android:layout_height="@dimen/qb_px_24"
                android:src="@drawable/floatview_selector_checkbox"
                android:layout_marginStart="@dimen/qb_px_24"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_ffffff_a90"
                android:gravity="center"
                android:id="@+id/tv_checkbox_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/qb_px_4"
                android:paddingEnd="@dimen/qb_px_4"/>
            <ImageView
                android:id="@+id/iv_checkbox_2_help"
                android:background="@drawable/bg_black_20"
                android:visibility="gone"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/float_ic_floatingsetting_icon_question"
                android:layout_marginStart="@dimen/qb_px_4"/>
            <ImageButton
                android:id="@+id/iv_checkbox_3"
                android:layout_width="@dimen/qb_px_24"
                android:layout_height="@dimen/qb_px_24"
                android:src="@drawable/floatview_selector_checkbox"
                android:layout_marginStart="@dimen/qb_px_24"
                style="@style/Widget.AppCompat.Button.Borderless"/>
            <TextView
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_ffffff_a90"
                android:gravity="center"
                android:id="@+id/tv_checkbox_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/qb_px_4"
                android:paddingEnd="@dimen/qb_px_4"/>
            <ImageView
                android:id="@+id/iv_checkbox_3_help"
                android:background="@drawable/bg_black_20"
                android:visibility="gone"
                android:layout_width="@dimen/qb_px_20"
                android:layout_height="@dimen/qb_px_20"
                android:src="@drawable/float_ic_floatingsetting_icon_question"
                android:layout_marginStart="@dimen/qb_px_4"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_ffffff_a50"
        android:gravity="center"
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/qb_px_4"
        android:paddingStart="@dimen/qb_px_4"
        android:paddingEnd="@dimen/qb_px_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/area_checkbox"/>
</LinearLayout>
