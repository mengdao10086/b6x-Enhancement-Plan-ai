<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_bg_bottom_dialog"
        android:layout_width="@dimen/qb_px_340"
        android:layout_height="@dimen/qb_px_300">
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_000000_a90"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:background="@color/color_000000_a04"
            android:layout_width="0dp"
            android:layout_height="@dimen/qb_px_44"
            android:text="@string/app_customer_service_notice_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <top.androidman.SuperButton
            android:id="@+id/btn_close"
            android:layout_width="@dimen/qb_px_44"
            android:layout_height="@dimen/qb_px_44"
            android:scaleType="centerInside"
            app:background_normalColor="@color/transparent"
            app:icon="@drawable/ic_close"
            app:iconColor="@color/color_000000_a30"
            app:iconHeight="@dimen/qb_px_16"
            app:iconWidth="@dimen/qb_px_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.flydigi.base.widget.ratingbar.CBRatingBar
            android:layout_gravity="center"
            android:id="@+id/cb_rating_bar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/qb_px_48"
            android:layout_marginTop="@dimen/qb_px_24"
            android:isIndicator="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:starCanTouch="true"
            app:starCount="5"
            app:starCoverColor="#fdac2d"
            app:starFillColor="@color/colorDivider"
            app:starShowStroke="false"
            app:starSize="@dimen/qb_px_34"
            app:starSpace="@dimen/qb_px_16"/>
        <TextView
            android:textSize="@dimen/sp_14"
            android:textColor="#fdac2d"
            android:layout_gravity="center"
            android:id="@+id/tv_level"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cb_rating_bar"/>
        <com.google.android.material.textfield.TextInputLayout
            android:gravity="top"
            android:id="@+id/area_content"
            android:background="@drawable/mian_bg_edit_text_rename"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_20"
            android:layout_marginStart="@dimen/qb_px_16"
            android:layout_marginEnd="@dimen/qb_px_16"
            app:counterEnabled="true"
            app:counterMaxLength="100"
            app:counterTextColor="@color/color_000000_a30"
            app:hintAnimationEnabled="false"
            app:hintEnabled="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_level">
            <com.google.android.material.textfield.TextInputEditText
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_000000_a90"
                android:textColorHint="@color/color_000000_a30"
                android:gravity="top"
                android:id="@+id/et_content"
                android:background="@color/transparent"
                android:padding="@dimen/qb_px_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/app_customer_service_notice_hint"
                android:lines="3"
                android:maxLength="100"/>
        </com.google.android.material.textfield.TextInputLayout>
        <Button
            android:enabled="false"
            android:textColor="@color/main_selector_text_color_action_button"
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/qb_px_16"
            android:text="@string/app_submit"
            android:layout_marginStart="@dimen/qb_px_16"
            android:layout_marginEnd="@dimen/qb_px_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/area_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
