<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root"
    android:background="@color/transparent_black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/top"
            android:layout_width="600dp"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_arrow_left"
                android:layout_width="26dp"
                android:layout_height="52dp"
                android:src="@drawable/float_view_icon_arrow_left"
                android:scaleType="fitXY"/>
            <RelativeLayout
                android:layout_width="522dp"
                android:layout_height="261dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp">
                <androidx.viewpager.widget.ViewPager
                    android:layout_gravity="center"
                    android:id="@+id/viewpager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
                <com.flydigi.base.widget.IndicatorView
                    android:id="@+id/indicator_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    app:currentColor="@color/color_white"
                    app:defaultColor="@color/colorTextSecondary"
                    app:radius="5dp"
                    app:space="7dp"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_arrow_right"
                android:layout_width="26dp"
                android:layout_height="52dp"
                android:src="@drawable/float_view_icon_arrow_right"
                android:scaleType="fitXY"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="25dp"
            android:layout_marginTop="18dp"
            android:layout_below="@+id/top">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layout_cancel_notice"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="38dp"
                android:layout_centerVertical="true">
                <ImageView
                    android:id="@+id/iv_cancel_notice"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/float_view_icon_checkbox_no"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/colorDivider"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="7dp"
                    android:text="@string/no_more_notice"
                    android:singleLine="true"/>
            </LinearLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/colorPrimary"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_setting"
                android:visibility="visible"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:text="@string/floatview_view_detail"
                android:singleLine="true"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/fl_progress"
            android:background="@color/color_black_trans_33"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/webview_close_n"
            android:scaleType="center"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</RelativeLayout>
