<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="@dimen/qb_px_8"
    android:paddingBottom="@dimen/qb_px_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/qb_px_16"
    android:paddingEnd="@dimen/qb_px_16">
    <TextView
        android:textSize="@dimen/sp_20"
        android:textStyle="bold"
        android:textColor="@color/color_000000_a90"
        android:layout_gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/device_my_game"/>
    <Space
        android:layout_width="@dimen/qb_px_20"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorPrimary"
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/btn_config_manage"
        android:paddingTop="@dimen/qb_px_8"
        android:paddingBottom="@dimen/qb_px_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/qb_px_56"
        android:text="@string/device_action_config_manage"
        android:layout_weight="1"/>
</LinearLayout>
